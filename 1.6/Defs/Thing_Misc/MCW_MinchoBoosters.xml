<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ============================================================ -->
  <!-- 智慧珉巧改造包系列：物品 + 制作配方 + 手术配方               -->
  <!-- 所有改造包在珉巧工作台制作，使用时为 100% 成功率手术。       -->
  <!-- ============================================================ -->

  <!-- ===== 智慧珉巧改造包 ===== -->
  <ThingDef ParentName="ResourceBase">
    <defName>MCW_MinchoIntelBooster</defName>
    <label>Mincho intelligence booster</label>
    <description>沁心糖研发的智慧珉巧改造包，接收改造的珉巧可以拥有更加高级的智能。</description>
    <!-- TODO(画师): 补充 graphicData 贴图 -->
    <stackLimit>10</stackLimit>
    <statBases>
      <MarketValue>2000</MarketValue>
      <MaxHitPoints>100</MaxHitPoints>
      <Mass>0.5</Mass>
    </statBases>
    <thingCategories>
      <li>Manufactured</li>
    </thingCategories>
  </ThingDef>

  <!-- ===== 智慧珉巧初级核心改造包 ===== -->

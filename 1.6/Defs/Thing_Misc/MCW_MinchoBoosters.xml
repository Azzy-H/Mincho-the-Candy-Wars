  <!-- ===================== 手术配方 ===================== -->

  <RecipeDef>
    <defName>MCW_Implant_MinchoIntelBooster</defName>
    <label>implant Mincho intelligence booster</label>
    <description>对普通珉巧使用智慧珉巧改造包，使其成为智慧珉巧。100% 成功率。</description>
    <jobString>Implanting Mincho intelligence booster.</jobString>
    <workerClass>MinchoCandyWars.Recipe_MinchoBooster</workerClass>
    <effectWorking>Surgery</effectWorking>
    <soundWorking>Recipe_Surgery</soundWorking>
    <workSpeedStat>MedicalOperationSpeed</workSpeedStat>
    <workSkill>Medicine</workSkill>
    <workAmount>2500</workAmount>
    <targetsBodyPart>false</targetsBodyPart>
    <hideBodyPartNames>true</hideBodyPartNames>
    <surgerySuccessChanceFactor>99999</surgerySuccessChanceFactor>
    <recipeUsers>
      <li>Mincho_ThingDef</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter><thingDefs><li>MCW_MinchoIntelBooster</li></thingDefs></filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs><li>MCW_MinchoIntelBooster</li></thingDefs>
    </fixedIngredientFilter>
    <modExtensions>
      <li Class="MinchoCandyWars.MinchoBoosterRecipeModExtension">
        <boosterType>Intel</boosterType>
      </li>
    </modExtensions>
  </RecipeDef>


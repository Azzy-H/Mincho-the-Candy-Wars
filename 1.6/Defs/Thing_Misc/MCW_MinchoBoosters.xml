    <!-- TODO(画师): 补充 graphicData 贴图 -->
    <stackLimit>10</stackLimit>
    <statBases>
      <MarketValue>800</MarketValue>
      <MaxHitPoints>100</MaxHitPoints>
      <Mass>0.5</Mass>
    </statBases>
    <thingCategories>
      <li>Manufactured</li>
    </thingCategories>
  </ThingDef>


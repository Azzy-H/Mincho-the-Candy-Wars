<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="Mincho_ApparelBase_Body">
    <defName>MCW_NurseOutfit</defName>
    <label>珉巧护士服</label>
    <description>甘露糖模仿人类护士制成的衣物，听说只要换上就可以获得医术加成！同时，还能让爱人为之倾倒。</description>
    <graphicData>
      <texPath>Things/Apparel/MCW_NurseOutfit/MCW_NurseOutfit</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
    </graphicData>
    <costStuffCount>40</costStuffCount>
    <stuffCategories>
      <li>Fabric</li>
      <li>Leathery</li>
    </stuffCategories>
    <statBases>
      <MaxHitPoints>250</MaxHitPoints>
      <WorkToMake>2500</WorkToMake>
      <Mass>0.8</Mass>
      <StuffEffectMultiplierArmor>0.3</StuffEffectMultiplierArmor>
      <StuffEffectMultiplierInsulation_Cold>0.35</StuffEffectMultiplierInsulation_Cold>
      <StuffEffectMultiplierInsulation_Heat>0.35</StuffEffectMultiplierInsulation_Heat>
      <ArmorRating_Sharp>0.05</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.05</ArmorRating_Blunt>
      <ArmorRating_Heat>0.05</ArmorRating_Heat>
      <Insulation_Cold>0.0</Insulation_Cold>
      <Insulation_Heat>2.0</Insulation_Heat>
      <EquipDelay>2</EquipDelay>
      <Beauty>1</Beauty>
    </statBases>
    <apparel>
      <wornGraphicPath>Things/Apparel/MCW_NurseOutfit/MCW_NurseOutfit</wornGraphicPath>
			<layers>
				<li>OnSkin</li>
				<!--
			<li>OnSkin</li>
			<li>Middle</li>
			<li>Shell</li>
			<li>Belt</li>
			<li>Overhead</li>
			-->
			</layers>
    </apparel>
  </ThingDef>

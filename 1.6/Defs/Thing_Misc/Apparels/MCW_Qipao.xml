<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ============================================================
       珉巧旗袍
       设定来源：!!AgentWorkZone!!/糖果大作战贴图需求和物品简易设定（鲨雕）.docx
         描述：非常便捷的服饰，让琉璃糖的战斗能加优美，并且可以吸引爱人！对了！还能防火！
         制作：蘑菇布x100  金属x20  翡翠x20
         效果：+200% 防火，+0.2 移动速度
       ============================================================ -->
  <ThingDef ParentName="Mincho_ApparelBase_Body">
    <defName>MCW_Qipao</defName>
    <label>珉巧旗袍</label>
    <description>非常便捷的服饰，让琉璃糖的战斗能加优美，并且可以吸引爱人！对了！还能防火！</description>
    <!--========== Graphic Data ==========-->
    <graphicData>
      <texPath>Things/Apparel/MCW_Qipao/MCW_Qipao</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
    </graphicData>
    <!--========== Crafting ==========
        甲方原文「蘑菇布x100  金属x20  翡翠x20」；
        金属取 Steel（vanilla 的 Metal 是 StuffAppearanceDef，不能用于 costList）。 -->
    <costList>
      <DevilstrandCloth>100</DevilstrandCloth>
      <Steel>20</Steel>
      <Jade>20</Jade>
    </costList>
    <!--========== Stat Base（占位数值） ==========-->
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <WorkToMake>3500</WorkToMake>
      <Mass>0.6</Mass>
      <ArmorRating_Sharp>0.05</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.05</ArmorRating_Blunt>
      <ArmorRating_Heat>0.05</ArmorRating_Heat>
      <Insulation_Cold>0.0</Insulation_Cold>
      <Insulation_Heat>2.0</Insulation_Heat>
      <EquipDelay>2</EquipDelay>
      <Beauty>2</Beauty>
    </statBases>
    <!--========== Equipped Stat Offsets（甲方：+200%防火 +0.2移动速度） ==========-->
    <equippedStatOffsets>
      <Flammability>-2</Flammability>
      <MoveSpeed>0.2</MoveSpeed>
    </equippedStatOffsets>
    <!--========== Apparel ==========-->
    <apparel>
      <wornGraphicPath>Things/Apparel/MCW_Qipao/MCW_Qipao</wornGraphicPath>
      <layers>
        <li>OnSkin</li>
      </layers>
    </apparel>
  </ThingDef>

</Defs>

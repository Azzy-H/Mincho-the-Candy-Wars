  <!-- ===================== 手术配方 ===================== -->

  <RecipeDef>
    <defName>MCW_Implant_MechaCandyUnlockItem</defName>
    <label>implant Mecha Candy unlock item</label>
    <description>对智慧珉巧使用千机糖糖饰解锁物品，解锁千机糖糖饰。100% 成功率。</description>
    <jobString>Implanting Mecha Candy unlock item.</jobString>
    <workerClass>MinchoCandyWars.Recipe_MinchoCandyUnlock</workerClass>
    <effectWorking>Surgery</effectWorking>
    <soundWorking>Recipe_Surgery</soundWorking>
    <workSpeedStat>MedicalOperationSpeed</workSpeedStat>
    <workSkill>Medicine</workSkill>
    <workAmount>2500</workAmount>
    <targetsBodyPart>false</targetsBodyPart>
    <hideBodyPartNames>true</hideBodyPartNames>
    <surgerySuccessChanceFactor>99999</surgerySuccessChanceFactor>
    <recipeUsers>
      <li>Mincho_ThingDef</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter><thingDefs><li>MCW_MechaCandyUnlockItem</li></thingDefs></filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs><li>MCW_MechaCandyUnlockItem</li></thingDefs>
    </fixedIngredientFilter>
    <modExtensions>
      <li Class="MinchoCandyWars.MinchoCandyUnlockRecipeModExtension">
        <candyType>MechaCandy</candyType>
      </li>
    </modExtensions>
  </RecipeDef>


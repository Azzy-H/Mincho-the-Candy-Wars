  <!-- ===================== 制作配方 ===================== -->

  <RecipeDef>
    <defName>MCW_Make_MechaCandyUnlockItem</defName>
    <label>make Mecha Candy unlock item</label>
    <description>制作千机糖糖饰解锁物品。</description>
    <jobString>Making Mecha Candy unlock item.</jobString>
    <workAmount>8000</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>Smith</effectWorking>
    <soundWorking>Recipe_Drug</soundWorking>
    <researchPrerequisite>MCW_Research_MechaCandy</researchPrerequisite>
    <recipeUsers>
      <li>Mincho_MinchoBench</li>
    </recipeUsers>
    <ingredients>
      <li MayRequire="Ludeon.RimWorld.Biotech">
        <filter><thingDefs><li>ArchiteCapsule</li></thingDefs></filter>
        <count>1</count>
      </li>
      <li>
        <filter><thingDefs><li>Mincho_Mintchoco</li></thingDefs></filter>
        <count>50</count>
      </li>
      <li>
        <filter><thingDefs><li>ComponentIndustrial</li></thingDefs></filter>
        <count>3</count>
      </li>
    </ingredients>
    <products>
      <MCW_MechaCandyUnlockItem>1</MCW_MechaCandyUnlockItem>
    </products>
    <workSkill>Crafting</workSkill>
  </RecipeDef>


  <!-- ===== 千机糖解锁物品 ===== -->
  <ThingDef ParentName="ResourceBase">
    <defName>MCW_MechaCandyChangeItem</defName>
    <label>Mecha Candy unlock item</label>
    <description>植入后解锁千机糖糖饰的使用权。</description>
    <thingClass>ThingWithComps</thingClass>
    <comps>
      <li Class="CompProperties_Usable">
        <useJob>UseItem</useJob>
        <useLabel>Implant {0_label}</useLabel>
        <showUseGizmo>true</showUseGizmo>
      </li>
      <li Class="CompProperties_UseEffect">
        <compClass>MinchoCandyWars.CompUseEffect_CandyChange</compClass>
      </li> 
    </comps>
    <!-- TODO(画师): 补充 graphicData 贴图 -->
    <stackLimit>10</stackLimit>
    <statBases>
      <MarketValue>1000</MarketValue>
      <MaxHitPoints>100</MaxHitPoints>
      <Mass>0.3</Mass>
    </statBases>
    <thingCategories>
      <li>Manufactured</li>
    </thingCategories>
  </ThingDef>


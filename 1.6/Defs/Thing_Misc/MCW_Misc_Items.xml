<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="OrganicProductBase">
    <defName>MCW_Delicious_Cookies</defName>
    <label>美味曲奇饼</label>
    <description>珉巧们使用稻米烘焙制成的美味曲奇饼，非常美味，但是不是很管饱。</description>
    <thingClass>ThingWithComps</thingClass>
    <thingCategories>
      <li>Foods</li>
    </thingCategories>
    <graphicData>
      <texPath>Things/Item/MCW_Delicious_Cookies</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <socialPropernessMatters>true</socialPropernessMatters>
    <statBases>
      <MarketValue>1.4</MarketValue>
      <Mass>0.018</Mass>
      <Flammability>0.6</Flammability>
      <WorkToMake>700</WorkToMake>
      <DeteriorationRate>2</DeteriorationRate>
      <Nutrition>0.05</Nutrition>
    </statBases>
    <ingestible>
      <foodType>Meal</foodType>
      <preferability>MealSimple</preferability>
      <ingestEffect>EatVegetarian</ingestEffect>
      <ingestSound>Meal_Eat</ingestSound>
      <optimalityOffsetHumanlikes>6</optimalityOffsetHumanlikes>
    </ingestible>
    <comps>
      <li Class="CompProperties_FoodPoisonable" />
    </comps>
    <allowedArchonexusCount>200</allowedArchonexusCount>
  </ThingDef>
  
  <RecipeDef>
    <defName>MCW_Make_Delicious_Cookies</defName>
    <label>制作美味曲奇饼 ×4</label>
    <description>制作美味曲奇饼，美味曲奇饼是珉巧们使用稻米烘焙制成的食物，非常美味，但是不是很管饱。</description>
    <jobString>制作美味曲奇饼</jobString>
    <workAmount>700</workAmount>
    <workSpeedStat>CookSpeed</workSpeedStat>
    <requiredGiverWorkType>Cooking</requiredGiverWorkType>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_CookMeal</soundWorking>
    <allowMixingIngredients>true</allowMixingIngredients>
    <ingredientValueGetterClass>IngredientValueGetter_Nutrition</ingredientValueGetterClass>
    <recipeUsers>
      <li>Mincho_MinchoBench</li>
      <li>ElectricStove</li>
      <li>FueledStove</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>RawRice</li>
          </thingDefs>
        </filter>
        <count>2</count>
      </li>
    </ingredients>
    <products>
      <MCW_Delicious_Cookies>4</MCW_Delicious_Cookies>
    </products>
    <workSkill>Cooking</workSkill>
    <displayPriority>1440</displayPriority>
  </RecipeDef>

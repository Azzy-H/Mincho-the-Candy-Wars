    <isBad>false</isBad>
    <defaultLabelColor>(0.9, 0.7, 0.2)</defaultLabelColor>
    <initialSeverity>1</initialSeverity>
    <minSeverity>0</minSeverity>
    <maxSeverity>1</maxSeverity>
    <stages>
      <li>
        <statOffsets>
          <IncomingDamageFactor>-0.9</IncomingDamageFactor>
          <MoveSpeed>-2.0</MoveSpeed>

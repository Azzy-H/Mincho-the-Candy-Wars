<Defs>
  <!-- 灭火器 -->
  <ThingDef ParentName="BuildingBase">
    <defName>MCW_FirefoamPopper</defName>
    <label>薄荷巧克力复用型号灭火单元</label>
    <description>薄荷巧克力复用型号灭火单元</description>
    <thingClass>Building_FirefoamPopper</thingClass>
    <graphicData>
      <texPath>Things/Building/Misc/MCW_FirefoamPopper</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shadowData>
        <volume>(0.25, 0.35, 0.25)</volume>
        <offset>(0,0,-0.1)</offset>
      </shadowData>
      <damageData>
        <rect>(0.2,0.2,0.6,0.6)</rect>
      </damageData>
    </graphicData>
    <tickerType>Normal</tickerType>
    <altitudeLayer>Building</altitudeLayer>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsMisc</li>
    </thingCategories>
    <statBases>
      <MaxHitPoints>50</MaxHitPoints>
      <WorkToBuild>1500</WorkToBuild>
      <Mass>10</Mass>
      <Flammability>1.0</Flammability>
      <Beauty>5</Beauty>
    </statBases>
    <fillPercent>0.30</fillPercent>
    <costList>
      <Mincho_ChocoStick>5</Mincho_ChocoStick>
      <Mincho_BlocksMintchoco>10</Mincho_BlocksMintchoco>
    </costList>
    <specialDisplayRadius>9.9</specialDisplayRadius>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <pathCost>30</pathCost>
    <passability>PassThroughOnly</passability>
    <designationCategory>Misc</designationCategory>
    <uiOrder>2070</uiOrder>
    <rotatable>true</rotatable>
    <designationHotKey>Misc7</designationHotKey>
    <!-- <researchPrerequisites>
      <li>Firefoam</li>
    </researchPrerequisites> -->
    <constructionSkillPrerequisite>5</constructionSkillPrerequisite>
    <comps>
      <li Class="CompProperties_Explosive">
        <explosiveRadius>9.9</explosiveRadius>
        <explosiveDamageType>Extinguish</explosiveDamageType>
        <startWickHitPointsPercent>-1</startWickHitPointsPercent>
        <startWickOnDamageTaken>
          <li>Flame</li>
        </startWickOnDamageTaken>
        <postExplosionSpawnThingDef>Filth_FireFoam</postExplosionSpawnThingDef>
        <postExplosionSpawnChance>1</postExplosionSpawnChance>
        <postExplosionSpawnThingCount>1</postExplosionSpawnThingCount>
        <applyDamageToExplosionCellsNeighbors>true</applyDamageToExplosionCellsNeighbors>
        <explosionEffect>ExtinguisherExplosion</explosionEffect>
        <explosionSound>Explosion_FirefoamPopper</explosionSound>
      </li>
      <li Class="CompProperties_Usable">
        <useJob>TriggerObject</useJob>
        <useLabel>Trigger {0_label}</useLabel>
      </li>
      <li Class="CompProperties_UseEffect">
        <compClass>CompUseEffect_StartWick</compClass>
      </li>
      <li Class="CompProperties_ProximityFuse">
        <target>Fire</target>
        <radius>5</radius>
      </li>
    </comps>
  </ThingDef>

  <!-- 床头柜 -->
  <ThingDef ParentName="TableBase">
    <defName>MCW_EndTable</defName>
    <label>薄荷冰淇淋床头柜</label>
    <description>睁眼就能见到美味的薄荷冰淇淋，天下还有比这更幸福的事情吗？</description>
    <surfaceType>Item</surfaceType>
    <uiOrder>2060</uiOrder>
    <graphicData>
      <texPath>Things/Building/EndTable/MCW_EndTable</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(0.8,0.85)</drawSize>
      <shadowData>
        <volume>(0.3, 0.6, 0.3)</volume>
      </shadowData>
    </graphicData>
    <statBases>
      <MaxHitPoints>75</MaxHitPoints>
      <WorkToBuild>1000</WorkToBuild>
      <Mass>5</Mass>
      <Flammability>1.0</Flammability>
      <Beauty>3</Beauty>
    </statBases>
    <pathCost>30</pathCost>
    <defaultPlacingRot>South</defaultPlacingRot>
    <stuffCategories Inherit="False" />
    <costStuffCount>0</costStuffCount>
    <placeWorkers>
      <li>PlaceWorker_ShowFacilitiesConnections</li>
    </placeWorkers>
    <!-- <researchPrerequisites>
      <li>ComplexFurniture</li>
    </researchPrerequisites> -->
    <costList>
      <Mincho_BlocksMintchoco>40</Mincho_BlocksMintchoco>
    </costList>
    <staticSunShadowHeight>0</staticSunShadowHeight>
    <castEdgeShadows>false</castEdgeShadows>
    <comps>
      <li Class="CompProperties_Facility">
        <statOffsets>
          <Comfort>0.1</Comfort>
        </statOffsets>
        <maxSimultaneous>1</maxSimultaneous>
        <mustBePlacedAdjacentCardinalToBedHead>true</mustBePlacedAdjacentCardinalToBedHead>
      </li>
    </comps>
  </ThingDef>

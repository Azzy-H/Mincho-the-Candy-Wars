  <ThingDef Abstract="True" Name="MCW_Mech_Base" ParentName="LightMechanoid">
    <!-- 子个体机械：手持武器整体偏移（x 横向, y 纵向） -->
    <modExtensions>
      <li Class="MinchoCandyWars.Review.ChildMechExtension">
        <weaponAimOffset>(0,0.18)</weaponAimOffset>
      </li>
    </modExtensions>
    <statBases>
      <MoveSpeed>5</MoveSpeed>
      <!-- <WastepacksPerRecharge MayRequire="Ludeon.RimWorld.Biotech">0</WastepacksPerRecharge> -->
    </statBases>
    <race>
      <mechEnabledWorkTypes>
        <li>Hauling</li>
        <!-- <li>Mining</li> -->
        <!-- <li>Construction</li> -->
        <!-- <li>Crafting</li> -->
        <!-- <li>Smithing</li> -->
        <!-- <li>Tailoring</li> -->
        <!-- <li>Cooking</li> -->
        <!-- <li>Research</li> -->
        <!-- <li>PlantCutting</li> -->
        <!-- <li>Growing</li> -->
        <li>Cleaning</li>
        <!-- <li>Doctor</li> -->
        <li>Firefighter</li>
      </mechEnabledWorkTypes>
      <lifeStageAges>
        <li>
          <def>MechanoidFullyFormed</def>
        </li>
      </lifeStageAges>
      <!-- <thinkTreeConstant>WarUrchinConstant</thinkTreeConstant> -->
      <!-- <baseHealthScale>4</baseHealthScale> -->
      <canFlyInVacuum>true</canFlyInVacuum>
    </race>
    <comps>
      <!-- 撒娇：承载亲昵的内置冷却（每台机械体各自计时）。
           派发逻辑见 Defs/MCW_Nuzzle/MCW_Nuzzle.xml + Source/.../Nuzzle/。 -->
      <li Class="MinchoCandyWars.Nuzzle.CompProperties_Nuzzle">
        <cooldownTicks>60000</cooldownTicks>
        <contactTicks>30</contactTicks>
        <maxDistance>40</maxDistance>
        <thoughtDef>MCW_NuzzledByMech</thoughtDef>
      </li>
 
    </comps>
  </ThingDef>
  <ThingDef ParentName="MCW_Mech_Base">
    <defName>MCW_Mech_I_Maid</defName>
    <label>次级珉巧子个体-女仆I型</label>
    <description>小小冰淇淋女仆，在内照顾姐姐们起居。</description>
    <!-- 设计值（参考工艺机）：带宽1 / 利器70% / 钝器70% / 热能50% / 移速3.2 / 固定工作等级12
         垃圾量 = 搬运机（BaseMechanoid 默认 5）的一半 = 2.5
         轻型：继承 MCW_Mech_Base → LightMechanoid 的 mechWeightClass=Light -->
    <statBases>
      <MoveSpeed>3.2</MoveSpeed>
      <BandwidthCost>1</BandwidthCost>
      <ArmorRating_Sharp>0.7</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.7</ArmorRating_Blunt>
      <ArmorRating_Heat>0.5</ArmorRating_Heat>
      <WastepacksPerRecharge MayRequire="Ludeon.RimWorld.Biotech">2.5</WastepacksPerRecharge>
    </statBases>
    <race>
      <mechFixedSkillLevel>12</mechFixedSkillLevel>
      <mechEnabledWorkTypes>
        <!-- <li>Hauling</li> -->
        <!-- <li>Mining</li> -->  
        <!-- <li>Construction</li> -->
        <!-- <li>Crafting</li> -->
        <!-- <li>Smithing</li> -->
        <!-- <li>Tailoring</li> -->
        <li>Cooking</li>
        <!-- <li>Research</li> -->
        <!-- <li>PlantCutting</li> -->
        <!-- <li>Growing</li> -->
        <!-- <li>Cleaning</li> -->
        <li>Doctor</li>
        <!-- 「照料」= 原版 Childcare（生物科技 DLC 的照料工作） -->
        <li>Childcare</li>
        <!-- 撒娇（WorkGiver MCW_Nuzzle_Basic）挂在「基础工作」下，机械体必须显式列出这个工作类型 -->
        <li>BasicWorker</li>
        <!-- <li>Firefighter</li> -->
      </mechEnabledWorkTypes>
    </race>
  </ThingDef>

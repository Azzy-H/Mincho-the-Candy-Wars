<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="Mincho_AnimalThingBase">
    <defName>MCW_MinchoSlime</defName>
    <label>珉巧史莱姆</label>
    <description>珉巧史莱姆</description>

    <statBases>
      <MaxNutrition>1</MaxNutrition>
      <MoveSpeed>6</MoveSpeed>
      <MarketValue>0</MarketValue>
      <LeatherAmount>0</LeatherAmount>
      <MeatAmount>0</MeatAmount>
      <ArmorRating_Blunt>0.5</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.5</ArmorRating_Sharp>
      <ArmorRating_Heat>0</ArmorRating_Heat>
			<ComfyTemperatureMin>-273</ComfyTemperatureMin>
			<ComfyTemperatureMax>45</ComfyTemperatureMax>
      <Wildness>0</Wildness>
      <Fertility MayRequire="Ludeon.RimWorld.Biotech">0</Fertility>
			<PsychicSensitivity>0</PsychicSensitivity>

      <WorkToMake>1000</WorkToMake>
    </statBases>

    <race>
      <trainability>Intermediate</trainability>
      <baseHealthScale>2</baseHealthScale>
      <baseHungerRate>0</baseHungerRate>
      <baseBodySize>1</baseBodySize>
			<petness>1</petness>
      <lifeExpectancy>1000</lifeExpectancy>
      <hasCorpse>true</hasCorpse> <!-- 不生成尸体的话，deathAction无法启动 -->
      <needsRest>false</needsRest>
      <hasMeat>false</hasMeat>
      <hasGenders>false</hasGenders>
      <disableIgniteVerb>true</disableIgniteVerb>
      <deathAction Class="MinchoCandyWars.DeathActionProperties_RevertDivide" Inherit="False"/>
      <ageGenerationCurve Inherit="False">
        <points>
          <li>(0,0)</li>
          <li>(0.75,1)</li>
          <li>(1,0)</li>
        </points>
      </ageGenerationCurve>
      <lifeStageAges>
        <li>
          <def>MCW_Slime_LifeStage_I</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>MCW_Slime_LifeStage_II</def>
          <minAge>0.25</minAge>
        </li>
        <li>
          <def>MCW_Slime_LifeStage_III</def>
          <minAge>0.75</minAge>
        </li>
        <li>
          <def>MCW_Slime_LifeStage_IV</def>
          <minAge>1</minAge>
        </li>
      </lifeStageAges>
    </race>

    <tools Inherit="False">
      <li>
        <label>拳头</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>100</power>
        <cooldownTime>1.25</cooldownTime>
        <soundMeleeHit>MeleeHit_BionicPunch</soundMeleeHit>
        <soundMeleeMiss>MeleeMiss_BionicPunch</soundMeleeMiss>
      </li>
    </tools>

    <comps>
    </comps>
  </ThingDef>

<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <ThingDef ParentName="PlantBase">
    <defName>MCW_Chocolate_Bush_Plant</defName>
    <label>巧克力灌木</label>
    <description>慧珉巧发明的神奇作物，用于快速产出巧克力，巧克力灌木只能在0度以下生长。</description>
		<thingClass>Plant</thingClass>
    <statBases>
      <MaxHitPoints>85</MaxHitPoints>
      <Nutrition>0.2</Nutrition>
			<Flammability>1</Flammability>
    </statBases>
    <graphicData>
      <texPath>Things/Plant/MCW_Chocolate_Bush</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <selectable>true</selectable>
    <pathCost>14</pathCost>
    <ingestible />
    <plant>
      <growDays>3.5</growDays>
      <dieIfLeafless>true</dieIfLeafless>
      <harvestTag>Standard</harvestTag>
      <harvestedThingDef>Mincho_ChocoStick</harvestedThingDef>
      <harvestYield>8</harvestYield>
      <sowMinSkill>5</sowMinSkill>
      <sowTags>
				<li>Mincho_MinchoshroomPlant</li>
      </sowTags>
      <topWindExposure>0.1</topWindExposure>
      <immatureGraphicPath>Things/Plant/MCW_Chocolate_Bush_Immature</immatureGraphicPath>
      <visualSizeRange>0.3~1.05</visualSizeRange>
      <wildOrder>2</wildOrder>
      <purpose>Food</purpose>
      <humanFoodPlant>true</humanFoodPlant>
			<minGrowthTemperature>-272</minGrowthTemperature>
			<minOptimalGrowthTemperature>-272</minOptimalGrowthTemperature>
			<maxOptimalGrowthTemperature>-5</maxOptimalGrowthTemperature>
			<maxGrowthTemperature>0</maxGrowthTemperature>
    </plant>
	</ThingDef>

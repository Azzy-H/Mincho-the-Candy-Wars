      <li>
        <statOffsets>
          <GlobalLearningFactor>5</GlobalLearningFactor>
          <WorkSpeedGlobal>5</WorkSpeedGlobal>
          <IncomingDamageFactor>-0.8</IncomingDamageFactor>
          <MoveSpeed>1.0</MoveSpeed>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>
</Defs>

<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 回收公司是制式高科技部队；装备生成沿用原版系统。 -->
  <PawnKindDef Name="MCW_RecycleTrooperBase" ParentName="MercenaryEliteTierBase" Abstract="True">
    <race>Human</race>
    <defaultFactionDef>MCW_RecycleCorp_Faction</defaultFactionDef>
    <combatPower>180</combatPower>
    <initialResistanceRange>17~27</initialResistanceRange>
    <itemQuality>Good</itemQuality>
    <gearHealthRange>1~1</gearHealthRange>
    <apparelMoney>5000~6500</apparelMoney>
    <apparelRequired Inherit="False"><li>Apparel_ArmorRecon</li><li>Apparel_ArmorHelmetRecon</li><li>Apparel_Pants</li><li>Apparel_BasicShirt</li></apparelRequired>
    <apparelTags Inherit="False"><li>IndustrialBasic</li></apparelTags>
    <apparelAllowHeadgearChance>1</apparelAllowHeadgearChance>
    <apparelColor>(0.25,0.28,0.32)</apparelColor>
    <weaponMoney>1600~2500</weaponMoney>
    <weaponTags Inherit="False"><li>SpacerGun</li></weaponTags>
    <skills><li><skill>Shooting</skill><range>10~14</range></li></skills>
  </PawnKindDef>
  <PawnKindDef ParentName="MCW_RecycleTrooperBase">
    <defName>MCW_RecycleCorp_Leader</defName>
    <label>Reclamation company leader</label>
    <factionLeader>true</factionLeader>
    <combatPower>260</combatPower>
    <itemQuality>Excellent</itemQuality>
    <apparelRequired Inherit="False"><li>Apparel_PowerArmor</li><li>Apparel_PowerArmorHelmet</li><li>Apparel_Pants</li><li>Apparel_BasicShirt</li></apparelRequired>
    <skills Inherit="False"><li><skill>Shooting</skill><range>13~17</range></li></skills>
    <canBeSapper>true</canBeSapper>
    <initialResistanceRange>17~27</initialResistanceRange>
  </PawnKindDef>
  <PawnKindDef ParentName="MCW_RecycleTrooperBase">
    <defName>MCW_RecycleCorp_Member</defName>
    <label>Reclamation company member</label>
  </PawnKindDef>

  <!-- 遭到追捕的珉巧：比普通珉巧更强，固定技能与特性 -->
  <PawnKindDef ParentName="MinchoBasePawnKind_Space">
    <defName>MCW_HuntedMincho_QS1</defName>
    <label>Hunted Mincho</label>
    <combatPower>80</combatPower>
    <requiredWorkTags>
      <li>Violent</li>
      <li>Cooking</li>
      <li>Social</li>
    </requiredWorkTags>
  </PawnKindDef>
</Defs>


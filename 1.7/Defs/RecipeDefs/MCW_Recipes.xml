<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- ================= 身体囤放增设手术 ================= -->
  <RecipeDef ParentName="SurgeryInstallImplantBase">
    <defName>MCW_InstallMinchoBodyStorage</defName>
    <label>Mincho body storage add surgery</label>
    <description>Install a body storage device into the mincho, consuming 5 components and granting +20 carrying capacity.</description>
    <descriptionHyperlinks>
      <ThingDef>ComponentIndustrial</ThingDef>
      <HediffDef>MCW_MinchoBodyStorageImplant</HediffDef>
    </descriptionHyperlinks>
    <jobString>Installing body storage device.</jobString>
    <surgerySuccessChanceFactor>2</surgerySuccessChanceFactor>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>ComponentIndustrial</li>
          </thingDefs>
        </filter>
        <count>5</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>ComponentIndustrial</li>
      </thingDefs>
    </fixedIngredientFilter>
    <addsHediff>MCW_MinchoBodyStorageImplant</addsHediff>
    <appliedOnFixedBodyParts>
      <li>Mincho_Torso</li>
    </appliedOnFixedBodyParts>
  </RecipeDef>
</Defs>

  <RecipeDef>
    <defName>MCW_Make_NanoShapedMinchoSlime085</defName>
    <modExtensions>
      <li Class="MinchoCandyWars.Review.NanoAnimalProductExtension">
        <pawnKind>MCW_MinchoSlime</pawnKind>
      </li>
    </modExtensions>
    <label>Shape Mincho slime</label>
    <description>Use ice cream and nano-shaping fluid to create a Mincho slime.</description>
    <jobString>Shaping a Mincho slime.</jobString>
    <workAmount>12000</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Crafting</workSkill>
    <recipeUsers><li>Mincho_MinchoBench</li></recipeUsers>
    <ingredients>
      <li><filter><thingDefs><li>MCW_Alpha_NanoShapingFluid</li></thingDefs></filter><count>1</count></li>
      <li><filter><categories><li>Mincho_IceCream</li></categories></filter><count>200</count></li>
    </ingredients>
    <allowMixingIngredients>true</allowMixingIngredients>
    <products><MCW_MinchoSlime>1</MCW_MinchoSlime></products>
    <fixedIngredientFilter>
      <thingDefs>
        <li>MCW_Alpha_NanoShapingFluid</li>
      </thingDefs>
      <categories>
        <li>Mincho_IceCream</li>
      </categories>
    </fixedIngredientFilter>
  </RecipeDef>

<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- ================= 囤放装置（植入 hediff） ================= -->
  <HediffDef ParentName="ImplantHediffBase">
    <defName>MCW_MinchoBodyStorageImplant</defName>
    <label>mincho body storage device</label>
    <description>An implanted mechanical storage organ that greatly increases the mincho's carrying capacity.</description>
    <defaultLabelColor>(0.6, 0.6, 1.0)</defaultLabelColor>
    <scenarioCanAdd>false</scenarioCanAdd>
    <maxSeverity>1</maxSeverity>
    <initialSeverity>1</initialSeverity>
    <stages>
      <li>
        <statOffsets>
          <CarryingCapacity>20</CarryingCapacity>
          <CarryWeight MayRequire="CETeam.CombatExtended">20</CarryWeight>
          <CarryBulk MayRequire="CETeam.CombatExtended">20</CarryBulk>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>
</Defs>

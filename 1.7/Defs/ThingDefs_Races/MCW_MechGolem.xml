<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="HeavyMechanoid" MayRequire="Ludeon.RimWorld.Biotech">
    <defName>MCW_Mech_Golem</defName>
    <label>珉巧魔像</label>
    <description>这是珉巧女巫召唤出的珉巧魔像的稳定版本，也是这个大家伙最初的样子。厚重的巧克力装甲和强壮的双臂使它擅长近战，也能搬运货物，但无法承担其他工作。\n\n控制核心被毁后，它仍能拖着受损的躯体继续行动，但已无法分辨敌我。再次被击杀或约一天后自行崩溃时，会留下可供复活的残骸。</description>
    <statBases>
      <MoveSpeed>5.5</MoveSpeed>
      <MarketValue>4000</MarketValue>
      <ComfyTemperatureMin>-273</ComfyTemperatureMin>
      <ComfyTemperatureMax>30</ComfyTemperatureMax>
      <ArmorRating_Sharp>1</ArmorRating_Sharp>
      <ArmorRating_Blunt>1</ArmorRating_Blunt>
      <ArmorRating_Heat>2</ArmorRating_Heat>
      <IncomingDamageFactor>0.25</IncomingDamageFactor>
      <PsychicSensitivity>0</PsychicSensitivity>
      <BandwidthCost>6</BandwidthCost>
    </statBases>
    <uiIconScale>1.75</uiIconScale>
    <race>
      <body>MinchoGolem</body>
      <baseBodySize>8</baseBodySize>
      <baseHealthScale>12</baseHealthScale>
      <hasCorpse>true</hasCorpse>
      <mechEnabledWorkTypes Inherit="False">
        <li>Hauling</li>
      </mechEnabledWorkTypes>
      <lifeStageAges Inherit="False">
        <li>
          <def>MechanoidFullyFormed</def>
          <minAge>0</minAge>
        </li>
      </lifeStageAges>
      <deathAction Class="MinchoCandyWars.DeathAction.DeathActionProperties_MechGolem" Inherit="False" />
      <soundMeleeHitPawn>Pawn_Melee_BigBash_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_BigBash_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_BigBash_Miss</soundMeleeMiss>
    </race>
    <tools Inherit="False">
      <li>
        <label>左拳</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>60</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>Hands</linkedBodyPartsGroup>
        <surpriseAttack>
          <extraMeleeDamages>
            <li>
              <def>Stun</def>
              <amount>14</amount>
            </li>
          </extraMeleeDamages>
        </surpriseAttack>
      </li>
      <li>
        <label>右拳</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>60</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>Hands</linkedBodyPartsGroup>
        <surpriseAttack>
          <extraMeleeDamages>
            <li>
              <def>Stun</def>
              <amount>14</amount>
            </li>
          </extraMeleeDamages>
        </surpriseAttack>
      </li>
      <li>
        <label>头槌</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>50</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>FullHead</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
        <chanceFactor>0.2</chanceFactor>
        <surpriseAttack>
          <extraMeleeDamages>
            <li>
              <def>Stun</def>
              <amount>14</amount>
            </li>
          </extraMeleeDamages>
        </surpriseAttack>
      </li>
    </tools>
  </ThingDef>
  <PawnKindDef ParentName="HeavyMechanoidKind" MayRequire="Ludeon.RimWorld.Biotech">
    <defName>MCW_Mech_Golem</defName>
    <label>珉巧魔像</label>
    <race>MCW_Mech_Golem</race>
    <combatPower>5000</combatPower>
    <allowInMechClusters>false</allowInMechClusters>
    <weaponTags Inherit="False" />
    <lifeStages>
      <li>
        <bodyGraphicData>
          <texPath>MinchoWitch/MinchoGolem/Texture</texPath>
          <drawSize>5</drawSize>
          <shadowData>
            <volume>(1,0.8,0.5)</volume>
            <offset>(0,0,-0.5)</offset>
          </shadowData>
        </bodyGraphicData>
        <dessicatedBodyGraphicData>
          <texPath>MinchoWitch/MinchoGolem/Texture</texPath>
          <drawSize>5</drawSize>
        </dessicatedBodyGraphicData>
      </li>
    </lifeStages>
  </PawnKindDef>
  <RecipeDef ParentName="HeavyMechanoidRecipe" MayRequire="Ludeon.RimWorld.Biotech">
    <defName>MCW_Mech_Golem_Recipe</defName>
    <label>培育珉巧魔像</label>
    <description>培育一个珉巧魔像机械体。</description>
    <researchPrerequisite>StandardMechtech</researchPrerequisite>
    <ingredients Inherit="False">
      <li>
        <filter>
          <thingDefs>
            <li>Mincho_BlocksMintchoco</li>
          </thingDefs>
        </filter>
        <count>500</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>ComponentSpacer</li>
          </thingDefs>
        </filter>
        <count>2</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>SubcoreRegular</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Plasteel</li>
          </thingDefs>
        </filter>
        <count>50</count>
      </li>
    </ingredients>
    <products>
      <MCW_Mech_Golem>1</MCW_Mech_Golem>
    </products>
    <descriptionHyperlinks>
      <ThingDef>MCW_Mech_Golem</ThingDef>
    </descriptionHyperlinks>
  </RecipeDef>
  <RecipeDef ParentName="BaseMechanoidResurrectionRecipe" MayRequire="Ludeon.RimWorld.Biotech">
    <defName>MCW_ResurrectGolem</defName>
    <label>复活珉巧魔像</label>
    <description>复活一个友方珉巧魔像。前提是机械体的残骸未被完全摧毁。</description>
    <ingredients Inherit="False">
      <li>
        <filter>
          <thingDefs>
            <li>Corpse_MCW_Mech_Golem</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Mincho_BlocksMintchoco</li>
          </thingDefs>
        </filter>
        <count>200</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Corpse_MCW_Mech_Golem</li>
      </thingDefs>
    </fixedIngredientFilter>
  </RecipeDef>
</Defs>

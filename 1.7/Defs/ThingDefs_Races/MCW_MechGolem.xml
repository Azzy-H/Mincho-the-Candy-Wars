<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="HeavyMechanoid" MayRequire="Ludeon.RimWorld.Biotech">
    <defName>MCW_Mech_Golem</defName>
    <label>Mincho golem</label>
    <description>The stable form of the Mincho witch summon. A heavy chocolate shell wraps strong arms; it carries cargo clumsily in peacetime and becomes a wall before its companions in war. After its core shatters the body sometimes keeps moving, though it no longer recognizes the one calling it.</description>
    <statBases>
      <MoveSpeed>5.5</MoveSpeed>
      <MarketValue>4000</MarketValue>
      <ComfyTemperatureMin>-273</ComfyTemperatureMin>
      <ComfyTemperatureMax>30</ComfyTemperatureMax>
      <ArmorRating_Sharp>1</ArmorRating_Sharp>
      <ArmorRating_Blunt>1</ArmorRating_Blunt>
      <ArmorRating_Heat>2</ArmorRating_Heat>
      <IncomingDamageFactor>0.25</IncomingDamageFactor>
      <PsychicSensitivity>0</PsychicSensitivity>
      <BandwidthCost>6</BandwidthCost>
    </statBases>
    <uiIconScale>1.75</uiIconScale>
    <race>
      <body>MinchoGolem</body>
      <baseBodySize>8</baseBodySize>
      <baseHealthScale>12</baseHealthScale>
      <hasCorpse>true</hasCorpse>
      <mechEnabledWorkTypes Inherit="False">
        <li>Hauling</li>
      </mechEnabledWorkTypes>
      <lifeStageAges Inherit="False">
        <li>
          <def>MechanoidFullyFormed</def>
          <minAge>0</minAge>
        </li>
      </lifeStageAges>
      <deathAction Class="MinchoCandyWars.DeathAction.DeathActionProperties_MechGolem" Inherit="False" />
      <soundMeleeHitPawn>Pawn_Melee_BigBash_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_BigBash_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_BigBash_Miss</soundMeleeMiss>
    </race>
    <tools Inherit="False">
      <li>
        <label>Left fist</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>60</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>Hands</linkedBodyPartsGroup>
        <surpriseAttack>
          <extraMeleeDamages>
            <li>
              <def>Stun</def>
              <amount>14</amount>
            </li>
          </extraMeleeDamages>
        </surpriseAttack>
      </li>
      <li>
        <label>Right fist</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>60</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>Hands</linkedBodyPartsGroup>
        <surpriseAttack>
          <extraMeleeDamages>
            <li>
              <def>Stun</def>
              <amount>14</amount>
            </li>
          </extraMeleeDamages>
        </surpriseAttack>
      </li>
      <li>
        <label>Headbutt</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>50</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>FullHead</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
        <chanceFactor>0.2</chanceFactor>
        <surpriseAttack>
          <extraMeleeDamages>
            <li>
              <def>Stun</def>
              <amount>14</amount>
            </li>
          </extraMeleeDamages>
        </surpriseAttack>
      </li>
    </tools>
  </ThingDef>
  <PawnKindDef ParentName="HeavyMechanoidKind" MayRequire="Ludeon.RimWorld.Biotech">
    <defName>MCW_Mech_Golem</defName>
    <label>Mincho golem</label>
    <race>MCW_Mech_Golem</race>
    <combatPower>5000</combatPower>
    <allowInMechClusters>false</allowInMechClusters>
    <weaponTags Inherit="False" />
    <lifeStages>
      <li>
        <bodyGraphicData>
          <texPath>MinchoWitch/MinchoGolem/Texture</texPath>
          <drawSize>5</drawSize>
          <shadowData>
            <volume>(1,0.8,0.5)</volume>
            <offset>(0,0,-0.5)</offset>
          </shadowData>
        </bodyGraphicData>
        <dessicatedBodyGraphicData>
          <texPath>MinchoWitch/MinchoGolem/Texture</texPath>
          <drawSize>5</drawSize>
        </dessicatedBodyGraphicData>
      </li>
    </lifeStages>
  </PawnKindDef>
  <RecipeDef ParentName="HeavyMechanoidRecipe" MayRequire="Ludeon.RimWorld.Biotech">
    <defName>MCW_Mech_Golem_Recipe</defName>
    <label>Incubate Mincho golem</label>
    <description>Incubate a Mincho golem mechanoid.</description>
    <researchPrerequisite>StandardMechtech</researchPrerequisite>
    <ingredients Inherit="False">
      <li>
        <filter>
          <thingDefs>
            <li>Mincho_BlocksMintchoco</li>
          </thingDefs>
        </filter>
        <count>500</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>ComponentSpacer</li>
          </thingDefs>
        </filter>
        <count>2</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>SubcoreRegular</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Plasteel</li>
          </thingDefs>
        </filter>
        <count>50</count>
      </li>
    </ingredients>
    <products>
      <MCW_Mech_Golem>1</MCW_Mech_Golem>
    </products>
    <descriptionHyperlinks>
      <ThingDef>MCW_Mech_Golem</ThingDef>
    </descriptionHyperlinks>
  </RecipeDef>
  <RecipeDef ParentName="BaseMechanoidResurrectionRecipe" MayRequire="Ludeon.RimWorld.Biotech">
    <defName>MCW_ResurrectGolem</defName>
    <label>Resurrect Mincho golem</label>
    <description>Resurrect a friendly Mincho golem, provided its remains have not been completely destroyed.</description>
    <ingredients>
      <li>
        <filter>
          <categories>
            <li>Corpses</li>
          </categories>
        </filter>
        <count>1</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Mincho_BlocksMintchoco</li>
          </thingDefs>
        </filter>
        <count>200</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Corpse_MCW_Mech_Golem</li>
        <li>Mincho_BlocksMintchoco</li>
      </thingDefs>
    </fixedIngredientFilter>
  </RecipeDef>
</Defs>
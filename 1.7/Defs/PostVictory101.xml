            </li>
          </effects>
        </action>
      </li>
      <li>
        <label>Wait until we have checked.</label>
        <action>
          <effects />
        </action>
      </li>
    </options>
  </MinchoCandyWars.StellarisEvent.StellarisEventDef>
  <QuestScriptDef>
    <defName>MCWQ101_Remnant</defName>
    <rootSelectionWeight>0</rootSelectionWeight>
    <defaultChallengeRating>2</defaultChallengeRating>
    <isRootSpecial>true</isRootSpecial>
    <defaultCharity>false</defaultCharity>
    <autoAccept>true</autoAccept>
    <sendAvailableLetter>false</sendAvailableLetter>
    <questNameRules>
      <rulesStrings>
        <li>questName-&gt;Clear out the remnants</li>
      </rulesStrings>
    </questNameRules>
    <questDescriptionRules>
      <rulesStrings>
        <li>questDescription-&gt;Clear the limited remnant garrison still able to fight here. Downed enemies need not be executed; there are no teleporters or endless reinforcements. 8-day limit after accepting; company raids remain disabled.</li>
      </rulesStrings>
    </questDescriptionRules>
    <root Class="QuestNode_Sequence">
      <nodes>
        <li Class="MinchoCandyWars.QuestStory.QuestNode_AllianceReward">
          <factionDef>MCW_Alliance_Faction</factionDef>
          <goodwillChange>10</goodwillChange>
          <endgameProgress>1</endgameProgress>
          <kind>9</kind>
        </li>
        <li Class="QuestNode_SubScript">
          <def>Util_RandomizePointsChallengeRating</def>
        </li>
        <li Class="QuestNode_GetMap" />
        <li Class="QuestNode_GetSiteTile">
          <storeAs>siteTile</storeAs>
          <preferCloserTiles>true</preferCloserTiles>
        </li>
        <li Class="QuestNode_GetSitePartDefsByTagsAndFaction">
          <storeAs>sitePartDefs</storeAs>
          <storeFactionAs>siteFaction</storeFactionAs>
          <sitePartsTags>
            <li>
              <tag>MCWQ101_RemnantCamp</tag>
            </li>
          </sitePartsTags>
        </li>
        <li Class="MinchoCandyWars.QuestStory.MissionFactionNode">
          <kind>9</kind>
        </li>
        <li Class="QuestNode_GetDefaultSitePartsParams">
          <tile>$siteTile</tile>
          <faction>$siteFaction</faction>
          <sitePartDefs>$sitePartDefs</sitePartDefs>
          <storeSitePartsParamsAs>sitePartsParams</storeSitePartsParamsAs>
        </li>
        <li Class="QuestNode_SubScript">
          <def>Util_GenerateSite</def>
          <parms>
            <hiddenSitePartsPossible>true</hiddenSitePartsPossible>
          </parms>
        </li>
        <li Class="QuestNode_SpawnWorldObjects">
          <worldObjects>$site</worldObjects>
          <defsToExcludeFromHyperlinks>Human</defsToExcludeFromHyperlinks>
        </li>
        <li Class="QuestNode_WorldObjectTimeout">
          <worldObject>$site</worldObject>
          <isQuestTimeout>true</isQuestTimeout>
          <delayTicks>480000</delayTicks>
          <node Class="QuestNode_End">
            <outcome>Fail</outcome>
            <sendStandardLetter>true</sendStandardLetter>
          </node>
        </li>
        <li Class="MinchoCandyWars.QuestStory.MissionNode">
          <kind>9</kind>
        </li>
      </nodes>
    </root>
  </QuestScriptDef>
  <SitePartDef>
    <defName>MCWQ101_RemnantCamp</defName>
    <label>Reclamation remnant camp</label>
    <workerClass>MinchoCandyWars.QuestStory.MissionSiteWorker</workerClass>
    <requiresFaction>true</requiresFaction>
    <siteTexture>World/WorldObjects/Sites/GenericSite</siteTexture>
    <expandingIconTexture>World/WorldObjects/Expanding/Sites/Outpost</expandingIconTexture>
    <tags>
      <li>MCWQ101_RemnantCamp</li>
    </tags>
    <gravShipsCanLandOn>true</gravShipsCanLandOn>
  </SitePartDef>
  <GenStepDef>
    <defName>MCWQ101_RemnantBuildings</defName>
    <linkWithSite>MCWQ101_RemnantCamp</linkWithSite>
    <order>1600</order>
    <genStep Class="MinchoCandyWars.QuestStory.MissionBuildings">

  <MinchoCandyWars.StellarisEvent.StellarisEventDef>
    <defName>MCWQ101_Event7</defName>
    <label>Supply settlement</label>
    <title>Qinxintang</title>
    <desc>Qinxintang: The resettlement will need some supplies. Not a campaign this time - could you gather a batch of chocolate bars for us? We will set aside another batch of goods in exchange.</desc>
    <pictures>
      <li>
        <path>Events/Portraits/MCW_Qinxintang_Smile</path>
      </li>
    </pictures>
    <triggers>
      <li Class="MinchoCandyWars.QuestStory.OfferTrigger">
        <kind>7</kind>
      </li>
    </triggers>
    <options>
      <li>
        <label>We will prepare it.</label>
        <action>
          <effects>
            <li Class="MinchoCandyWars.QuestStory.OfferEffect">
              <kind>7</kind>
              <reject>false</reject>
            </li>
          </effects>
        </action>
      </li>
      <li>
        <label>We cannot arrange it this time.</label>
        <action>
          <effects>
            <li Class="MinchoCandyWars.QuestStory.OfferEffect">
              <kind>7</kind>
              <reject>true</reject>
            </li>
          </effects>
        </action>
      </li>
      <li>
        <label>Wait until we have checked.</label>
        <action>
          <effects />
        </action>
      </li>
    </options>
  </MinchoCandyWars.StellarisEvent.StellarisEventDef>

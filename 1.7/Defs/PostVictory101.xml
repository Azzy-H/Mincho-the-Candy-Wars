              <kind>9</kind>
              <reject>false</reject>
            </li>
          </effects>
        </action>
      </li>
      <li>
        <label>We cannot arrange it this time.</label>
        <action>
          <effects>
            <li Class="MinchoCandyWars.QuestStory.OfferEffect">

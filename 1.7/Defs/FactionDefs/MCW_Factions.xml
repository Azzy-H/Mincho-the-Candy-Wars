<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <FactionDef ParentName="MinchoFactionBase">
    <defName>MCW_Alliance_Faction</defName>
    <label>Mincho Alliance</label>
    <description>The Mincho Alliance founded by Qinxintang. They know how to create smart Mincho, and they take in and protect other Mincho.</description>
    <leaderTitle>(leader title)</leaderTitle>
    <leaderForceGenerateNewPawn>true</leaderForceGenerateNewPawn>
    <fixedName>Mincho Alliance</fixedName>
    <!-- <fixedLeaderKinds>
      <li>WULA_Legion_PawnKind</li>
    </fixedLeaderKinds> -->
    <factionIconPath>UI/FactionIcons/MCW_Alliance_Faction</factionIconPath>
    <!-- 派系图标？ -->
    <canGenerateQuestSites>false</canGenerateQuestSites>
    <displayInFactionSelection>false</displayInFactionSelection>
    <earliestRaidDays>999999</earliestRaidDays>
    <!-- 通过事件发动袭击，不走常规袭击 -->
    <permanentEnemy>false</permanentEnemy>
    <hostileToFactionlessHumanlikes>true</hostileToFactionlessHumanlikes>
    <settlementTexturePath>World/WorldObjects/DefaultSettlement</settlementTexturePath>
    <maxConfigurableAtWorldCreation>1</maxConfigurableAtWorldCreation>
    <configurationListOrderPriority>900</configurationListOrderPriority>
    <disallowedRaidAgeRestrictions>
      <li MayRequire="Ludeon.RimWorld.Biotech">Children</li>
    </disallowedRaidAgeRestrictions>
    <settlementNameMaker>MCW_AllianceSettlementNames</settlementNameMaker>
  </FactionDef>
  <!-- 回收公司：闪耀世界甜品公司下属的回收部门，专门追捕逃逸的珉巧。
       继承自原版 OutlanderRough（人类派系、有外交好感度），
       因此开局是中立而非永久敌对 —— 他们需要先与玩家"交涉"，之后才可能转为敌对。
       permanentEnemy 由事件通过 Effect_SetFactionRelation 在运行时改写。 -->
  <FactionDef ParentName="FactionBase">
    <defName>MCW_RecycleCorp_Faction</defName>
    <modExtensions>
      <li Class="MinchoCandyWars.Review.FactionLoadoutExtension">
        <apparel>MCW_Paralyzer</apparel>
        <chance>0.2</chance>
        <onlyFighters>true</onlyFighters>
      </li>
    </modExtensions>
    <label>Recycle Corporation</label>
    <description>The asset reclamation division of the Glitterworld Dessert Company. Nominally a legitimate salvage firm, in practice it hunts down and dismantles escaped Mincho and smart Mincho.</description>
    <basicMemberKind>MCW_RecycleCorp_Member</basicMemberKind>
    <fixedName>Reclamation Company</fixedName>
    <pawnSingular>reclamation trooper</pawnSingular>
    <pawnsPlural>reclamation troopers</pawnsPlural>
    <leaderTitle>reclamation company leader</leaderTitle>
    <requiredCountAtGameStart>1</requiredCountAtGameStart>
    <maxConfigurableAtWorldCreation>1</maxConfigurableAtWorldCreation>
    <configurationListOrderPriority>2000</configurationListOrderPriority>
    <displayInFactionSelection>false</displayInFactionSelection>
    <canGenerateQuestSites>false</canGenerateQuestSites>
    <factionIconPath>UI/FactionIcons/MCW_RecycleCorp_Faction</factionIconPath>
    <settlementTexturePath>World/WorldObjects/DefaultSettlement</settlementTexturePath>
    <techLevel>Archotech</techLevel>
    <hidden>false</hidden>
    <rescueesCanJoin>false</rescueesCanJoin>
    <autoFlee>true</autoFlee>
    <apparelStuffFilter>
      <thingDefs>
        <li>Synthread</li>
        <li>Hyperweave</li>
        <li>Plasteel</li>
      </thingDefs>
    </apparelStuffFilter>
    <maxPawnCostPerTotalPointsCurve>
      <points>
        <li>(100,100)</li>
        <li>(10000,10000)</li>
      </points>
    </maxPawnCostPerTotalPointsCurve>
    <raidsForbidden>false</raidsForbidden>
    <backstoryFilters>
      <li>
        <categories>
          <li>Pirate</li>
        </categories>
      </li>
    </backstoryFilters>
    <raidCommonalityFromPointsCurve>
      <points>
        <li>(0, 1)</li>
      </points>
    </raidCommonalityFromPointsCurve>
    <raidLootMaker>OutlanderRaidLootMaker</raidLootMaker>
    <pawnGroupMakers>
      <li>
        <kindDef>Combat</kindDef>
        <options>
          <MCW_RecycleCorp_Member>8</MCW_RecycleCorp_Member>
          <MCW_RecycleCorp_Leader>2</MCW_RecycleCorp_Leader>
        </options>
      </li>
      <li>
        <kindDef>Peaceful</kindDef>
        <options>
          <MCW_RecycleCorp_Member>8</MCW_RecycleCorp_Member>
          <MCW_RecycleCorp_Leader>2</MCW_RecycleCorp_Leader>
        </options>
      </li>
      <li>
        <kindDef>Trader</kindDef>
        <traders>
          <Town_Trader>1</Town_Trader>
        </traders>
        <carriers>
          <Muffalo>6</Muffalo>
          <Dromedary>5</Dromedary>
          <Alpaca>2.5</Alpaca>
          <Elephant>2</Elephant>
        </carriers>
        <guards>
          <MCW_RecycleCorp_Member>8</MCW_RecycleCorp_Member>
          <MCW_RecycleCorp_Leader>2</MCW_RecycleCorp_Leader>
        </guards>
      </li>
      <li>
        <kindDef>Settlement</kindDef>
        <options>
          <MCW_RecycleCorp_Member>8</MCW_RecycleCorp_Member>
          <MCW_RecycleCorp_Leader>2</MCW_RecycleCorp_Leader>
        </options>
      </li>
      <li>
        <kindDef>Settlement_RangedOnly</kindDef>
        <options>
          <MCW_RecycleCorp_Member>8</MCW_RecycleCorp_Member>
          <MCW_RecycleCorp_Leader>2</MCW_RecycleCorp_Leader>
        </options>
      </li>
    </pawnGroupMakers>
    <permanentEnemy>false</permanentEnemy>
  </FactionDef>
</Defs>
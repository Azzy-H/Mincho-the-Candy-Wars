<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    ============================================================================
    questA4：珉巧同盟联络 —— 事件「遗迹探索」
    ============================================================================
    由统一入口 MCW_Event_AllianceGreeting 分流（MCW_NextQuest flag 随机到 A4 时显示）。

    选项：
      是   → 触发 questB4（IncidentDef MCW_GiveQuest_QuestB4）
      否   → 沁心糖好感度 -10，记下"已拒绝"标记
      待定 → 关闭窗口，之后可以重新联络
    ============================================================================
  -->
  <MinchoCandyWars.StellarisEvent.StellarisEventDef>
    <defName>MCW_Event_QuestA4_AllianceContact</defName>
    <label>遗迹探索</label>
    <title>沁心糖</title>
    <desc>我的同盟！你知道我们的由来吗？我们虽然看起来很像是某种幻想生物，比如史莱姆？实际上我们是闪耀世界的科技产物，而我们的主要构成就是β型纳米塑形虫。\n\n我们通过信息网得知了这颗星球上或许有一些被回收的同类留下的β型纳米塑形虫。虽然我们无法利用这些来复活她们，但是这些重要资源仍然可以用来研究我们自身。\n\n说了这么多，其实就是希望你能帮我们去探索一个遗迹，那里可能有遗留的β型纳米塑形液。</desc>
    <backgroundPath>Events/tile_large_bg</backgroundPath>
    <pictures>
      <li>
        <path>Events/Portraits/MCW_Qinxintang_Smile</path>
      </li>
    </pictures>

    <immediate>
      <effects>
        <li Class="MinchoCandyWars.StellarisEvent.Effect_EnsureFactionExists">
          <factionDef>MCW_Alliance_Faction</factionDef>
        </li>
      </effects>
    </immediate>

    <options>
      <li>
        <label>是-OK！我喜欢探险！</label>
        <desc>接受探索请求，前往遗迹寻找β型纳米塑形液。</desc>
        <action>
          <effects>
            <li Class="MinchoCandyWars.StellarisEvent.Effect_FireIncident">
              <defName>MCW_GiveQuest_QuestB4</defName>
            </li>
            <li Class="MinchoCandyWars.StellarisEvent.Effect_SetFlag">
              <flagName>MCW_QuestA4_Accepted</flagName>
              <valueType>Bool</valueType>
              <boolValue>true</boolValue>
              <setMode>Override</setMode>
              <local>false</local>
            </li>
          </effects>
        </action>
      </li>

      <li>
        <label>否-抱歉，我们目前没法帮助你</label>
        <desc>拒绝探索请求。沁心糖对你的好感度会下降。</desc>
        <action>
          <effects>
            <li Class="MinchoCandyWars.StellarisEvent.Effect_AdjustFactionGoodwill">
              <factionDef>MCW_Alliance_Faction</factionDef>
              <goodwillDelta>-10</goodwillDelta>
            </li>
            <li Class="MinchoCandyWars.StellarisEvent.Effect_SetFlag">
              <flagName>MCW_QuestA4_Declined</flagName>
              <valueType>Bool</valueType>
              <boolValue>true</boolValue>
              <setMode>Override</setMode>
              <local>false</local>
            </li>
          </effects>
        </action>
      </li>

      <li>
        <label>待定-稍等下，我们研究下去哪里的路线</label>
        <desc>暂时不做决定，关闭窗口。之后可以重新联络珉巧同盟。</desc>
        <action>
          <effects />
        </action>
      </li>
    </options>
  </MinchoCandyWars.StellarisEvent.StellarisEventDef>
</Defs>

<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    ============================================================================
    questA3：珉巧同盟协助请求 —— 事件「袭击协助」
    ============================================================================
    由统一入口 MCW_Event_AllianceGreeting 分流（A2 接受后显示）。

    选项：
      是   → 触发 questB3（IncidentDef MCW_GiveQuest_QuestB3）
      否   → 沁心糖好感度 -10，记下"已拒绝"标记
      待定 → 什么都不做，关闭窗口；之后可以重新联络珉巧同盟
    ============================================================================
  -->
  <MinchoCandyWars.StellarisEvent.StellarisEventDef>
    <defName>MCW_Event_QuestA3_AllianceContact</defName>
    <label>袭击协助</label>
    <title>沁心糖</title>
    <desc>感谢你的接听，我们计划袭击回收公司的据点，希望你们可以协助我们击溃他们。可以吗？</desc>
    <backgroundPath>Events/tile_large_bg</backgroundPath>
    <pictures>
      <li>
        <path>Events/Portraits/MCW_Qinxintang_Smile</path>
      </li>
    </pictures>

    <immediate>
      <effects>
        <li Class="MinchoCandyWars.StellarisEvent.Effect_EnsureFactionExists">
          <factionDef>MCW_Alliance_Faction</factionDef>
        </li>
      </effects>
    </immediate>

    <options>
      <li>
        <label>是-我们也打算狠狠收拾他们！</label>
        <desc>接受协助请求，与珉巧同盟一起突袭回收部队的前哨站。</desc>
        <action>
          <effects>
            <li Class="MinchoCandyWars.StellarisEvent.Effect_FireIncident">
              <defName>MCW_GiveQuest_QuestB3</defName>
            </li>
            <li Class="MinchoCandyWars.StellarisEvent.Effect_SetFlag">
              <flagName>MCW_QuestA3_Accepted</flagName>
              <valueType>Bool</valueType>
              <boolValue>true</boolValue>
              <setMode>Override</setMode>
              <local>false</local>
            </li>
          </effects>
        </action>
      </li>

      <li>
        <label>否-抱歉，我们目前没法帮助你</label>
        <desc>拒绝协助请求。沁心糖对你的好感度会下降。</desc>
        <action>
          <effects>
            <li Class="MinchoCandyWars.StellarisEvent.Effect_AdjustFactionGoodwill">
              <factionDef>MCW_Alliance_Faction</factionDef>
              <goodwillDelta>-10</goodwillDelta>
            </li>
            <li Class="MinchoCandyWars.StellarisEvent.Effect_SetFlag">
              <flagName>MCW_QuestA3_Declined</flagName>
              <valueType>Bool</valueType>
              <boolValue>true</boolValue>
              <setMode>Override</setMode>
              <local>false</local>
            </li>
          </effects>
        </action>
      </li>

      <li>
        <label>待定-马上！我们正在制作强大的武器！</label>
        <desc>暂时不做决定，关闭窗口。准备好后可以重新联络珉巧同盟。</desc>
        <action>
          <effects />
        </action>
      </li>
    </options>
  </MinchoCandyWars.StellarisEvent.StellarisEventDef>
</Defs>

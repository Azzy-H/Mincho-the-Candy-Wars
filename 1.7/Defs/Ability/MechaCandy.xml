<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <AbilityDef ParentName="AbilityTouchBase">
        <defName>MCW_MechaCandyAbility_MechGestatorAcceleration</defName>
        <abilityClass>MinchoCandyWars.Abilities.MinchoCandyAbility</abilityClass>
        <label>mech gestator acceleration</label>
        <description>TODO</description>
        <iconPath>UI/Gizmos/Abilities/Mecha/MCW_MechGestatorAcceleration</iconPath>        <!-- TODO -->
        <warmupStartSound>Coagulate_Cast</warmupStartSound>
        <jobDef>CastAbilityOnThingMelee</jobDef>
        <!--<category></category> TODO-->
        <displayOrder>400</displayOrder>
        <hostile>false</hostile>
        <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
        <cooldownTicksRange>2500</cooldownTicksRange>
        <verbProperties>
            <verbClass>Verb_CastAbilityTouch</verbClass>
            <drawAimPie>false</drawAimPie>
            <range>-1</range>
            <warmupTime>1</warmupTime>
            <targetParams>
                <canTargetLocations>false</canTargetLocations>
                <canTargetPawns>false</canTargetPawns>
                <canTargetBuildings>true</canTargetBuildings>
                <canTargetItems>false</canTargetItems>
                <canTargetAnimals>false</canTargetAnimals>
                <canTargetHumans>false</canTargetHumans>
                <canTargetMechs>false</canTargetMechs>
                <canTargetSelf>false</canTargetSelf>
                <mapObjectTargetsMustBeAutoAttackable>false</mapObjectTargetsMustBeAutoAttackable>
            </targetParams>
        </verbProperties>
        <comps>
            <li>
                <compClass>MinchoCandyWars.Abilities.MechaCandy.CompAbilityEffect_MechGestatorAcceleration</compClass>
            </li>
            <li Class="CompProperties_AbilityRequiresCapacity">                <!-- 需要操作能力 -->
                <capacity>Manipulation</capacity>
            </li>
        </comps>
        <modExtensions>
            <li Class="MinchoCandyWars.Abilities.MinchoAbilityDefModExtension">
                <candyType>MechaCandy</candyType>
                <requiredMinchoCoreGrade>1</requiredMinchoCoreGrade>
                <requiredMinchoBodyGrade>1</requiredMinchoBodyGrade>
                <requiredMinchoCandyValue>30</requiredMinchoCandyValue>
            </li>
        </modExtensions>
    </AbilityDef>

    <AbilityDef>
        <defName>MCW_MechaCandyAbility_EMPBolt</defName>
        <abilityClass>MinchoCandyWars.Abilities.MinchoCandyAbility</abilityClass>
        <label>EMP bolt</label>
        <description>TODO</description>
        <verbProperties>
            <range>30</range>
        </verbProperties>
        <comps>
            <li Class="CompProperties_AbilityLaunchProjectile">
                <projectileDef>MCW_MechaCandyAbility_EMPBolt</projectileDef>
            </li>
        </comps>
        <iconPath>UI/Gizmos/Abilities/Mecha/MCW_EMPBolt</iconPath>
        <cooldownTicksRange>5000</cooldownTicksRange>
        <aiCanUse>true</aiCanUse>
        <displayOrder>300</displayOrder>
        <category>Sanguophage</category>
        <sendMessageOnCooldownComplete>true</sendMessageOnCooldownComplete>
        <verbProperties>
            <verbClass>Verb_CastAbility</verbClass>
            <range>12</range>
            <warmupTime>1</warmupTime>
            <targetParams>
                <canTargetLocations>true</canTargetLocations>
            </targetParams>
        </verbProperties>
        <modExtensions>
            <li Class="MinchoCandyWars.Abilities.MinchoAbilityDefModExtension">
                <candyType>MechaCandy</candyType>
                <requiredMinchoCoreGrade>2</requiredMinchoCoreGrade>
                <requiredMinchoBodyGrade>3</requiredMinchoBodyGrade>
                <requiredMinchoCandyValue>50</requiredMinchoCandyValue>
            </li>
        </modExtensions>
    </AbilityDef>

    <ThingDef ParentName="BaseBullet">
        <defName>MCW_MechaCandyAbility_EMPBolt</defName>
        <label>EMPBolt</label>
        <graphicData>
            <texPath>Things/Projectile/Bullet_Big</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>TransparentPostLight</shaderType>
            <drawSize>2</drawSize>
        </graphicData>
        <thingClass>MinchoCandyWars.Projectiles.Projectile_Explosive_NoFriendlyFire</thingClass>
        <projectile>
            <speed>70</speed>
            <damageDef>EMP</damageDef>
            <damageAmountBase>25</damageAmountBase>
            <armorPenetrationBase>0.4</armorPenetrationBase>
            <explosionRadius>3</explosionRadius>
            <ai_IsIncendiary>true</ai_IsIncendiary>
            <arcHeightFactor>0.2</arcHeightFactor>
            <shadowSize>0.6</shadowSize>
        </projectile>
    </ThingDef>


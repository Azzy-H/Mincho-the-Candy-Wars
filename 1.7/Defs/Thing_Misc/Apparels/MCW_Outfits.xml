  <ThingDef ParentName="Mincho_ApparelBase_Body">
    <defName>MCW_MechaArmor</defName>
    <label>珉巧机械师装甲</label>
    <description>千机糖在深入研究人类的机械师套装后改良出的适合珉巧们使用的机械师套装，虽然看起来材料很少，但是实际上！更加坚固！</description>
    <graphicData>
      <texPath>Things/Apparel/Icons/MCW_MechaArmor</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <costList>
      <DevilstrandCloth>40</DevilstrandCloth>
      
      <Plasteel>100</Plasteel>
      <ComponentSpacer>4</ComponentSpacer>
    <SignalChip MayRequire="Ludeon.RimWorld.Biotech">1</SignalChip></costList>
    <statBases>
      <MaxHitPoints>500</MaxHitPoints>
      <WorkToMake>12000</WorkToMake>
      <Mass>5</Mass>
      <Flammability>0.4</Flammability>
      <ArmorRating_Sharp>0.6</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.6</ArmorRating_Blunt>
      <ArmorRating_Heat>0.5</ArmorRating_Heat>
      <EquipDelay>3</EquipDelay>
    <Insulation_Cold>50</Insulation_Cold><Insulation_Heat>40</Insulation_Heat><StuffEffectMultiplierArmor>0.8</StuffEffectMultiplierArmor></statBases>
    <apparel>
      <wornGraphicPath>Things/Apparel/MCW_MechaArmorWorn/MCW_MechaArmor</wornGraphicPath>
      <layers><li>Middle</li></layers>
    </apparel>
    <colorGenerator Class="ColorGenerator_Options">
      <options>
        <li>
          <weight>10</weight>
          <only>(1,1,1,1)</only>
        </li>
      </options>
    </colorGenerator>
    <comps>
      <li Class="Mincho_The_Mint_Choco_Slime.CompProperties_CauseRemoveHediff_Apparel">
        <hediff>MCW_MechaArmor_AddonHediff</hediff>
        <part>Mincho_Torso</part>
      </li>
    </comps>
  <uiIconPath>Things/Apparel/Icons/MCW_MechaArmor</uiIconPath><recipeMaker><researchPrerequisite MayRequire="Ludeon.RimWorld.Biotech">StandardMechtech</researchPrerequisite><researchPrerequisites><li>ReconArmor</li></researchPrerequisites><recipeUsers Inherit="False"><li>FabricationBench</li></recipeUsers></recipeMaker><equippedStatOffsets><MechBandwidth MayRequire="Ludeon.RimWorld.Biotech">18</MechBandwidth><WorkSpeedGlobalOffsetMech MayRequire="Ludeon.RimWorld.Biotech">0.30</WorkSpeedGlobalOffsetMech><MoveSpeed>1.6</MoveSpeed><WorkSpeedGlobal>0.08</WorkSpeedGlobal><VacuumResistance MayRequire="Ludeon.RimWorld.Odyssey">0.32</VacuumResistance></equippedStatOffsets><costStuffCount>50</costStuffCount><stuffCategories><li>Metallic</li></stuffCategories></ThingDef>
  <HediffDef>
    <defName>MCW_MechaArmor_AddonHediff</defName>
    <label>机械师装甲附加件</label>
    <hediffClass>HediffWithComps</hediffClass>
    <description>机械师装甲的头部附加物与翅膀部件。</description>
    <isBad>false</isBad>
    <priceImpact>false</priceImpact>
    <renderNodeProperties>
      <!-- 头部附加物 -->
      <li>
        <nodeClass>PawnRenderNode_AttachmentHead</nodeClass>
        <workerClass>PawnRenderNodeWorker_FlipWhenCrawling</workerClass>
        <texPath>Things/Apparel/MCW_MechaArmor/MCW_MechaArmor_HeadAddon</texPath>
        <parentTagDef>Head</parentTagDef>
        <useSkinShader>false</useSkinShader>
        <useRottenColor>false</useRottenColor>
        <drawData>
          <dataNorth>
            <offset>(0, 0, 0)</offset>
            <layer>65</layer>
          </dataNorth>
          <dataEast>
            <offset>(0, 0, 0)</offset>
            <layer>65</layer>
          </dataEast>
          <dataSouth>
            <offset>(0, 0, 0)</offset>
            <layer>65</layer>
          </dataSouth>
          <dataWest>
            <offset>(0, 0, 0)</offset>
            <layer>65</layer>
          </dataWest>
        </drawData>
      </li>
      <!-- 翅膀 -->
      
    </renderNodeProperties>
    <stages>
      <li>
      </li>
    </stages>
  </HediffDef>
  

      <Insulation_Heat>5</Insulation_Heat>
      <EquipDelay>2</EquipDelay>
      <Beauty>1</Beauty>
    </statBases>
    <apparel>
      <wornGraphicPath>Things/Apparel/MCW_NurseOutfit/MCW_NurseOutfit</wornGraphicPath>
			<layers Inherit="False"><li>Middle</li></layers>
    </apparel>
    <colorGenerator Class="ColorGenerator_Options">
      <options>
        <li>
          <weight>10</weight>
          <only>(1,1,1,1)</only>
        </li>
      </options>
    </colorGenerator>
  <uiIconPath>Things/Apparel/Icons/MCW_NurseOutfit</uiIconPath><costList Inherit="False"><Steel>5</Steel></costList><equippedStatOffsets><MedicalTendQuality>0.2</MedicalTendQuality></equippedStatOffsets></ThingDef>

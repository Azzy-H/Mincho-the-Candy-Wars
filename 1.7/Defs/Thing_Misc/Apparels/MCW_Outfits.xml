    <graphicData>
      <texPath>Things/Apparel/MCW_HoloVisor/MCW_HoloVisor</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
    </graphicData>
    <costList>
      <Steel>50</Steel>
      <Plasteel>50</Plasteel>
      <ComponentSpacer>1</ComponentSpacer>
    </costList>
    <colorGenerator Class="ColorGenerator_Options">
      <options>
        <li>
          <weight>10</weight>
          <only>(1,1,1,1)</only>
        </li>
      </options>
    </colorGenerator>
    <statBases>
      <MaxHitPoints>150</MaxHitPoints>
      <WorkToMake>3000</WorkToMake>
      <Mass>0.3</Mass>
      <Flammability>0.2</Flammability>
      <ArmorRating_Sharp>0.2</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.2</ArmorRating_Blunt>
      <ArmorRating_Heat>0.2</ArmorRating_Heat>
      <EquipDelay>1.5</EquipDelay>
    </statBases>
    <apparel>
      <wornGraphicPath>Things/Apparel/MCW_HoloVisor/MCW_HoloVisor</wornGraphicPath>
      <bodyPartGroups>
        <li>FullHead</li>
      </bodyPartGroups>
      <renderSkipFlags Inherit="False">
        <li>None</li>
      </renderSkipFlags>
      <wornGraphicData>
        <renderUtilityAsPack>true</renderUtilityAsPack>
        <north>
          <offset>(0,-0.15)</offset>
        </north>
        <south>
          <offset>(0,-0.15)</offset>
        </south>
        <east>
          <offset>(0,-0.15)</offset>
        </east>
        <west>
          <offset>(0,-0.15)</offset>
        </west>
      </wornGraphicData>
      <layers>
        <li>EyeCover</li>
      </layers>
    </apparel>
  </ThingDef>
</Defs>

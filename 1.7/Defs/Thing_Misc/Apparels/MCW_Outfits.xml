<Defs>
  <ThingDef ParentName="Mincho_ApparelBase_Body">
    <defName>MCW_NurseOutfit</defName>
    <label>Mincho nurse outfit</label>
    <description>Clothing sewn by the nectar candy in imitation of a human nurse uniform, its soft fabric carrying a faint sweetness. She believes gentle care should begin at the very first glance.</description>
    <graphicData>
      <texPath>Things/Apparel/Icons/MCW_NurseOutfit</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <costStuffCount>5</costStuffCount>
    <stuffCategories>
      <li>Metallic</li>
    </stuffCategories>
    <costList>
      <Cloth>40</Cloth>
    </costList>
    <statBases>
      <MaxHitPoints>250</MaxHitPoints>
      <WorkToMake>2500</WorkToMake>
      <Mass>0.8</Mass>
      <StuffEffectMultiplierArmor>0.5</StuffEffectMultiplierArmor>
      <StuffEffectMultiplierInsulation_Cold>0.4</StuffEffectMultiplierInsulation_Cold>
      <StuffEffectMultiplierInsulation_Heat>0.4</StuffEffectMultiplierInsulation_Heat>
      <ArmorRating_Sharp>0.2</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.2</ArmorRating_Blunt>
      <ArmorRating_Heat>0.2</ArmorRating_Heat>
      <Insulation_Cold>5</Insulation_Cold>
      <Insulation_Heat>5</Insulation_Heat>
      <EquipDelay>2</EquipDelay>
      <Beauty>1</Beauty>
    </statBases>
    <apparel>
      <wornGraphicPath>Things/Apparel/MCW_NurseOutfit/MCW_NurseOutfit</wornGraphicPath>
      <layers Inherit="False">
        <li>Middle</li>
      </layers>
    </apparel>
    <colorGenerator Class="ColorGenerator_Options">
      <options>
        <li>
          <weight>10</weight>
          <only>(1,1,1,1)</only>
        </li>
      </options>
    </colorGenerator>
    <uiIconPath>Things/Apparel/Icons/MCW_NurseOutfit</uiIconPath>
    <costList Inherit="False">
      <Steel>5</Steel>
    </costList>
    <equippedStatOffsets>
      <MedicalTendQuality>0.2</MedicalTendQuality>
    </equippedStatOffsets>
  </ThingDef>

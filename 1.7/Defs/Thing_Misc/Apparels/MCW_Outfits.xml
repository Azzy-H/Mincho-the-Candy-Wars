  <ThingDef ParentName="Mincho_ApparelBase_Body">
    <defName>MCW_MechaArmor</defName>
    <label>Mincho mechanitor armor</label>
    <description>Armor refitted by the mecha candy from a human mechanitor suit. Beneath its deceptively thin shell hides tightly interlocking protection and a few clever touches she is rather proud of.</description>
    <graphicData>
      <texPath>Things/Apparel/Icons/MCW_MechaArmor</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <costList>
      <DevilstrandCloth>40</DevilstrandCloth>
      <Plasteel>100</Plasteel>
      <ComponentSpacer>4</ComponentSpacer>
      <SignalChip MayRequire="Ludeon.RimWorld.Biotech">1</SignalChip>
    </costList>
    <statBases>
      <MaxHitPoints>500</MaxHitPoints>
      <WorkToMake>12000</WorkToMake>
      <Mass>5</Mass>
      <Flammability>0.4</Flammability>
      <ArmorRating_Sharp>0.6</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.6</ArmorRating_Blunt>
      <ArmorRating_Heat>0.5</ArmorRating_Heat>
      <EquipDelay>3</EquipDelay>
      <Insulation_Cold>50</Insulation_Cold>
      <Insulation_Heat>40</Insulation_Heat>
      <StuffEffectMultiplierArmor>0.8</StuffEffectMultiplierArmor>
    </statBases>
    <apparel>
      <wornGraphicPath>Things/Apparel/MCW_MechaArmorWorn/MCW_MechaArmor</wornGraphicPath>
      <layers>
        <li>Middle</li>
      </layers>
    </apparel>
    <colorGenerator Class="ColorGenerator_Options">
      <options>
        <li>
          <weight>10</weight>
          <only>(1,1,1,1)</only>
        </li>
      </options>
    </colorGenerator>
    <comps>
    </comps>
    <uiIconPath>Things/Apparel/Icons/MCW_MechaArmor</uiIconPath>
    <recipeMaker>
      <researchPrerequisite MayRequire="Ludeon.RimWorld.Biotech">StandardMechtech</researchPrerequisite>
      <researchPrerequisites>
        <li>ReconArmor</li>
      </researchPrerequisites>
      <recipeUsers Inherit="False">
        <li>FabricationBench</li>
      </recipeUsers>
    </recipeMaker>
    <equippedStatOffsets>
      <MechBandwidth MayRequire="Ludeon.RimWorld.Biotech">18</MechBandwidth>
      <WorkSpeedGlobalOffsetMech MayRequire="Ludeon.RimWorld.Biotech">0.30</WorkSpeedGlobalOffsetMech>
      <MoveSpeed>1.6</MoveSpeed>
      <WorkSpeedGlobal>0.08</WorkSpeedGlobal>
      <VacuumResistance MayRequire="Ludeon.RimWorld.Odyssey">0.32</VacuumResistance>
    </equippedStatOffsets>
    <costStuffCount>50</costStuffCount>
    <stuffCategories>
      <li>Metallic</li>
    </stuffCategories>
  </ThingDef>
  <HediffDef>
    <defName>MCW_MechaArmor_AddonHediff</defName>
    <label>Mechanitor armor add-on</label>
    <hediffClass>HediffWithComps</hediffClass>
    <description>The head attachment and wing components of the mechanitor armor.</description>
    <isBad>false</isBad>
    <priceImpact>false</priceImpact>
    <renderNodeProperties>
      <!-- 头部附加物 -->
      <li>
        <nodeClass>PawnRenderNode_AttachmentHead</nodeClass>
        <workerClass>PawnRenderNodeWorker_FlipWhenCrawling</workerClass>
        <texPath>Things/Apparel/MCW_MechaArmor/MCW_MechaArmor_HeadAddon</texPath>
        <parentTagDef>Head</parentTagDef>
        <colorType>Custom</colorType>
        <color>(1,1,1,1)</color>
        <useSkinShader>false</useSkinShader>
        <useRottenColor>false</useRottenColor>
        <drawData>
          <dataNorth>
            <offset>(0, 0, -0.08)</offset>
            <layer>65</layer>
          </dataNorth>
          <dataEast>
            <offset>(0, 0, -0.08)</offset>
            <layer>65</layer>
          </dataEast>
          <dataSouth>
            <offset>(0, 0, -0.08)</offset>
            <layer>65</layer>
          </dataSouth>
          <dataWest>
            <offset>(0, 0, -0.08)</offset>
            <layer>65</layer>
          </dataWest>
        </drawData>
      </li>
      <!-- 翅膀 -->
    </renderNodeProperties>
    <!-- 脱下全息面罩时自动移除该视觉 Hediff（配合 MCW_CompProperties_CauseHediffAtPart） -->
    <comps>
      <li Class="HediffCompProperties_RemoveIfApparelDropped" />
    </comps>
    <stages>
      <li>
        <!-- 纯视觉 Hediff：不进入健康面板显示（DevMode 的"Show hidden Hediffs"仍可见） -->
        <becomeVisible>false</becomeVisible>
      </li>
    </stages>
  </HediffDef>
  <ThingDef ParentName="Mincho_ApparelBase_Hat">
    <defName>MCW_HoloVisor</defName>
    <label>Mincho mechanitor holo visor</label>
    <description>A holo visor made by the mecha candy, crisp points of light arranged before the eyes. She insists the problem of human helmets blocking the view is definitely not that she put it on backwards.</description>
    <graphicData>
      <texPath>Things/Apparel/Icons/MCW_HoloVisor</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <costList>
      <Steel>50</Steel>
      <Plasteel>50</Plasteel>
      <ComponentSpacer>1</ComponentSpacer>
      <SignalChip MayRequire="Ludeon.RimWorld.Biotech">1</SignalChip>
    </costList>
    <colorGenerator Class="ColorGenerator_Options">
      <options>
        <li>
          <weight>10</weight>
          <only>(1,1,1,1)</only>
        </li>
      </options>
    </colorGenerator>
    <statBases>
      <MaxHitPoints>150</MaxHitPoints>
      <WorkToMake>3000</WorkToMake>
      <Mass>0.3</Mass>
      <Flammability>0.2</Flammability>
      <ArmorRating_Sharp>0.2</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.2</ArmorRating_Blunt>
      <ArmorRating_Heat>0.1</ArmorRating_Heat>
      <EquipDelay>1.5</EquipDelay>
      <Insulation_Cold>50</Insulation_Cold>
      <Insulation_Heat>30</Insulation_Heat>
    </statBases>
    <apparel>
      <tags>
        <!-- 供糖饰渲染节点判断：带此 tag 的服饰会遮住面部，糖饰应隐藏。 -->
        <li>MCW_FaceCover</li>
      </tags>
      <wornGraphicPath>Things/Apparel/MCW_HoloVisor/MCW_HoloVisor</wornGraphicPath>
      <bodyPartGroups>
        <li>FullHead</li>
      </bodyPartGroups>
      <renderSkipFlags Inherit="False">
        <li>None</li>
      </renderSkipFlags>
      <wornGraphicData>
        <renderUtilityAsPack>true</renderUtilityAsPack>
        <north>
          <offset>(0,-0.15)</offset>
        </north>
        <south>
          <offset>(0,-0.15)</offset>
        </south>
        <east>
          <offset>(0,-0.15)</offset>
        </east>
        <west>
          <offset>(0,-0.15)</offset>
        </west>
      </wornGraphicData>
      <layers>
        <li>EyeCover</li>
        <li>Overhead</li>
      </layers>
      <immuneToToxGasExposure>true</immuneToToxGasExposure>
    </apparel>
    <uiIconPath>Things/Apparel/Icons/MCW_HoloVisor</uiIconPath>
    <equippedStatOffsets>
      <MechBandwidth MayRequire="Ludeon.RimWorld.Biotech">16</MechBandwidth>
      <WorkSpeedGlobalOffsetMech MayRequire="Ludeon.RimWorld.Biotech">0.20</WorkSpeedGlobalOffsetMech>
      <ShootingAccuracyPawn>3</ShootingAccuracyPawn>
      <WorkSpeedGlobal>0.08</WorkSpeedGlobal>
      <VacuumResistance MayRequire="Ludeon.RimWorld.Odyssey">0.69</VacuumResistance>
    </equippedStatOffsets>
    <recipeMaker>
      <researchPrerequisite MayRequire="Ludeon.RimWorld.Biotech">StandardMechtech</researchPrerequisite>
      <researchPrerequisites>
        <li>ReconArmor</li>
      </researchPrerequisites>
      <recipeUsers Inherit="False">
        <li>FabricationBench</li>
      </recipeUsers>
    </recipeMaker>
    <comps>
      <li Class="Mincho_The_Mint_Choco_Slime.CompProperties_CauseRemoveHediff_Apparel">
        <hediff>MCW_MechaArmor_AddonHediff</hediff>
        <part>Head</part>
      </li>
    </comps>
  </ThingDef>
</Defs>

<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="Mincho_ApparelBase_Body">
    <defName>MCW_CookiesShield</defName>
    <label>曲奇盾牌</label>
    <description>当你看到一个巨大的且咬不动的美味曲奇饼时，很不幸，其实它是一个盾牌。\n\n装备后会在征召时自动举起盾牌以获得防护加成，平时则背在身后。</description>
    <graphicData>
      <texPath>Things/Apparel/MCW_Shield/MCW_Cookies_shield</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
    </graphicData>
    <costList Inherit="False"><MCW_Delicious_Cookies>20</MCW_Delicious_Cookies><Uranium>10</Uranium></costList>
    <statBases>
      <MaxHitPoints>300</MaxHitPoints>
      <WorkToMake>4500</WorkToMake>
      <Mass>4</Mass>
      <Flammability>0</Flammability>
      <EquipDelay>1.5</EquipDelay>
      <!-- 材质贡献系数（甜饼盾）：锐/钝 0.4，热 0.2；实际值 = 基值 + 系数 × 材质强度 -->
      <MCW_ShieldCoef_Sharp>0.4</MCW_ShieldCoef_Sharp>
      <MCW_ShieldCoef_Heat>0.2</MCW_ShieldCoef_Heat>
    </statBases>
    <!-- 面板展示用：装备后面板显示「盾牌可以给予」的防御力 -->
    <equippedStatOffsets>
      <MCW_ShieldArmor_Sharp>0.3</MCW_ShieldArmor_Sharp>
      <MCW_ShieldArmor_Blunt>0.3</MCW_ShieldArmor_Blunt>
      <MCW_ShieldArmor_Heat>0.1</MCW_ShieldArmor_Heat>
    </equippedStatOffsets>
    <apparel>
      <wornGraphicData>
        <renderUtilityAsPack>true</renderUtilityAsPack>
      </wornGraphicData>
      <!-- 全透明 worn 贴图：盾牌本体不在此层绘制 -->
      <wornGraphicPath>Things/MCW_Empty</wornGraphicPath>
      <layers>
        <li>MCW_Shield</li>
      </layers>
    </apparel>
    <comps>
      <li Class="MinchoCandyWars.CompProperties_MCWShieldApparel">
        <hediffWhenDrafted>MCW_CookiesShield_DraftedHediff</hediffWhenDrafted>
        <hediffWhenUndrafted>MCW_CookiesShield_UndraftedHediff</hediffWhenUndrafted>
      </li>
    </comps>
  <costStuffCount>50</costStuffCount><stuffCategories Inherit="False"><li>Metallic</li></stuffCategories></ThingDef>
  <HediffDef>
    <defName>MCW_CookiesShield_DraftedHediff</defName>
    <label>举盾防御</label>
    <hediffClass>MinchoCandyWars.Review.Hediff_ShieldDefense</hediffClass>
    <description>举盾时获得盾牌防护，同时射击精度降低80%；近战命中不受影响。背盾后移除此防护和射击惩罚。</description>
    <isBad>false</isBad>
    <priceImpact>false</priceImpact>
    <renderNodeProperties>
      <li>
        <nodeClass>PawnRenderNode_AttachmentHead</nodeClass>
        <workerClass>PawnRenderNodeWorker_FlipWhenCrawling</workerClass>
        <texPath>Things/Apparel/MCW_Shield/MCW_Cookies_shield</texPath>
        <parentTagDef>Body</parentTagDef>
        <useSkinShader>false</useSkinShader>
        <useRottenColor>false</useRottenColor>
        <drawSize>1.75</drawSize>
        <drawData><dataNorth><offset>(0, 0, 0)</offset><layer>-5</layer></dataNorth><dataEast><offset>(0, 0, 0)</offset><layer>25</layer></dataEast><dataSouth><offset>(0, 0, 0)</offset><layer>25</layer></dataSouth><dataWest><offset>(0, 0, 0)</offset><layer>25</layer></dataWest></drawData>
      </li>
    </renderNodeProperties>
    <stages>
      <li>
      <statFactors><ShootingAccuracyPawn>0.2</ShootingAccuracyPawn></statFactors></li>
    </stages>
  </HediffDef>
  <HediffDef>
    <defName>MCW_CookiesShield_UndraftedHediff</defName>
    <label>背盾</label>
    <hediffClass>HediffWithComps</hediffClass>
    <description>该士兵将曲奇盾牌背至身后，行动自如。</description>
    <isBad>false</isBad>
    <priceImpact>false</priceImpact>
    <renderNodeProperties>
      <li>
        <nodeClass>PawnRenderNode_AttachmentHead</nodeClass>
        <workerClass>PawnRenderNodeWorker_FlipWhenCrawling</workerClass>
        <texPath>Things/Apparel/MCW_Shield/MCW_Cookies_shield_behind</texPath>
        <parentTagDef>Body</parentTagDef>
        <useSkinShader>false</useSkinShader>
        <useRottenColor>false</useRottenColor>
        <drawSize>1.75</drawSize>
        <drawData><dataNorth><offset>(0, 0, 0)</offset><layer>25</layer></dataNorth><dataEast><offset>(0, 0, 0)</offset><layer>25</layer></dataEast><dataSouth><offset>(0, 0, 0)</offset><layer>-5</layer></dataSouth><dataWest><offset>(0, 0, 0)</offset><layer>25</layer></dataWest></drawData>
      </li>
    </renderNodeProperties>
    <stages>
      <li>
      </li>
    </stages>
  </HediffDef>


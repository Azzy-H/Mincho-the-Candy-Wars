<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="Mincho_ApparelBase_Body">
    <defName>MCW_CookiesShield</defName>
    <label>Cookie shield</label>
    <description>A huge, tooth-achingly solid cookie. The amber candy raises it before her companions, and always has to remind people: this one really is not for eating.</description>
    <graphicData>
      <texPath>Things/Apparel/Icons/CookiesShield</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <ignoreThingDrawColor>true</ignoreThingDrawColor>
    </graphicData>
    <costList Inherit="False">
      <MCW_Delicious_Cookies>20</MCW_Delicious_Cookies>
      <Uranium>10</Uranium>
    </costList>
    <statBases>
      <MaxHitPoints>300</MaxHitPoints>
      <WorkToMake>4500</WorkToMake>
      <Mass>4</Mass>
      <Flammability>0</Flammability>
      <EquipDelay>1.5</EquipDelay>
      <!-- 材质贡献系数（甜饼盾）：锐/钝 0.4，热 0.2；实际值 = 基值 + 系数 × 材质强度 -->
      <MCW_ShieldCoef_Sharp>0.4</MCW_ShieldCoef_Sharp>
      <MCW_ShieldCoef_Heat>0.2</MCW_ShieldCoef_Heat>
    </statBases>
    <!-- 面板展示用：装备后面板显示「盾牌可以给予」的防御力 -->
    <equippedStatOffsets>
      <MCW_ShieldArmor_Sharp>0.3</MCW_ShieldArmor_Sharp>
      <MCW_ShieldArmor_Blunt>0.3</MCW_ShieldArmor_Blunt>
      <MCW_ShieldArmor_Heat>0.1</MCW_ShieldArmor_Heat>
    </equippedStatOffsets>
    <apparel>
      <wornGraphicData>
        <renderUtilityAsPack>true</renderUtilityAsPack>
      </wornGraphicData>
      <!-- 全透明 worn 贴图：盾牌本体不在此层绘制 -->
      <wornGraphicPath>Things/MCW_Empty</wornGraphicPath>
      <layers>
        <li>MCW_Shield</li>
      </layers>
    </apparel>
    <comps>
      <li Class="MinchoCandyWars.CompProperties_MCWShieldApparel">
        <hediffWhenDrafted>MCW_CookiesShield_DraftedHediff</hediffWhenDrafted>
        <hediffWhenUndrafted>MCW_CookiesShield_UndraftedHediff</hediffWhenUndrafted>
      </li>
    </comps>
    <costStuffCount>50</costStuffCount>
    <stuffCategories Inherit="False">
      <li>Metallic</li>
    </stuffCategories>
  </ThingDef>
  <HediffDef>
    <defName>MCW_CookiesShield_DraftedHediff</defName>
    <label>Shield raised</label>
    <hediffClass>MinchoCandyWars.Review.Hediff_ShieldDefense</hediffClass>
    <description>While the shield is raised you gain its protection, but shooting accuracy drops 80%; melee accuracy is unaffected. Stowing the shield removes both the protection and the penalty. Aiming while the shield is raised with a ranged weapon in the main hand takes twice as long (+100%).</description>
    <isBad>false</isBad>
    <priceImpact>false</priceImpact>
    <renderNodeProperties>
      <li>
        <nodeClass>PawnRenderNode_AttachmentHead</nodeClass>
        <workerClass>MinchoCandyWars.Render.PawnRenderNodeWorker_CookieShield</workerClass>
        <texPath>Things/Apparel/MCW_Shield/MCW_Cookies_shield</texPath>
        <parentTagDef>Body</parentTagDef>
        <useSkinShader>false</useSkinShader>
        <useRottenColor>false</useRottenColor>
        <drawSize>1.75</drawSize>
        <drawData>
          <dataNorth>
            <offset>(0, 0, 0)</offset>
            <layer>-5</layer>
          </dataNorth>
          <dataEast>
            <offset>(0, 0, 0)</offset>
            <layer>45</layer>
          </dataEast>
          <dataSouth>
            <offset>(0, 0, 0)</offset>
            <layer>45</layer>
          </dataSouth>
          <dataWest>
            <offset>(0, 0, 0)</offset>
            <layer>45</layer>
          </dataWest>
        </drawData>
      </li>
    </renderNodeProperties>
    <stages>
      <li>
        <statFactors>
          <ShootingAccuracyPawn>0.2</ShootingAccuracyPawn>
        </statFactors>
      </li>
    </stages>
  </HediffDef>
  <HediffDef>
    <defName>MCW_CookiesShield_UndraftedHediff</defName>
    <label>Shield stowed</label>
    <hediffClass>HediffWithComps</hediffClass>
    <description>This soldier has slung the cookie shield on her back and moves freely.</description>
    <isBad>false</isBad>
    <priceImpact>false</priceImpact>
    <renderNodeProperties>
      <li>
        <nodeClass>PawnRenderNode_AttachmentHead</nodeClass>
        <workerClass>MinchoCandyWars.Render.PawnRenderNodeWorker_CookieShield</workerClass>
        <texPath>Things/Apparel/MCW_Shield/MCW_Cookies_shield_behind</texPath>
        <parentTagDef>Body</parentTagDef>
        <useSkinShader>false</useSkinShader>
        <useRottenColor>false</useRottenColor>
        <drawSize>1.75</drawSize>
        <drawData>
          <dataNorth>
            <offset>(0, 0, 0)</offset>
            <layer>45</layer>
          </dataNorth>
          <dataEast>
            <offset>(0, 0, 0)</offset>
            <layer>45</layer>
          </dataEast>
          <dataSouth>
            <offset>(0, 0, 0)</offset>
            <layer>-5</layer>
          </dataSouth>
          <dataWest>
            <offset>(0, 0, 0)</offset>
            <layer>45</layer>
          </dataWest>
        </drawData>
      </li>
    </renderNodeProperties>
    <stages>
      <li>
      </li>
    </stages>
  </HediffDef>
  <ThingDef ParentName="Mincho_ApparelBase_Body">
    <defName>MCW_TowerShield</defName>
    <label>Mint ice cream chocolate tower shield</label>
    <description>Thick chocolate wraps a cool mint core into a steady great shield. Behind it, even the smoke blowing past seems a little thinner.</description>
    <tickerType>Normal</tickerType>
    <graphicData>
      <texPath>Things/Apparel/Icons/TowerShield</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawRotated>false</drawRotated>
    </graphicData>
    <costList Inherit="False">
      <Mincho_ChocoStick>80</Mincho_ChocoStick>
      <Mincho_Mintchoco>200</Mincho_Mintchoco>
    </costList>
    <statBases>
      <MaxHitPoints>400</MaxHitPoints>
      <WorkToMake>8000</WorkToMake>
      <Mass>6</Mass>
      <Flammability>0</Flammability>
      <EquipDelay>2</EquipDelay>
      <!-- 材质贡献系数（塔盾）：锐/钝 0.6，热 0.3 -->
      <MCW_ShieldCoef_Sharp>0.6</MCW_ShieldCoef_Sharp>
      <MCW_ShieldCoef_Heat>0.3</MCW_ShieldCoef_Heat>
    </statBases>
    <!-- 面板展示用：装备后面板显示「盾牌可以给予」的防御力 -->
    <equippedStatOffsets>
      <MCW_ShieldArmor_Sharp>0.5</MCW_ShieldArmor_Sharp>
      <MCW_ShieldArmor_Blunt>0.5</MCW_ShieldArmor_Blunt>
      <MCW_ShieldArmor_Heat>0.2</MCW_ShieldArmor_Heat>
      <MoveSpeed>-0.8</MoveSpeed>
    </equippedStatOffsets>
    <apparel>
      <wornGraphicData>
        <renderUtilityAsPack>true</renderUtilityAsPack>
      </wornGraphicData>
      <wornGraphicPath>Things/MCW_Empty</wornGraphicPath>
      <layers>
        <li>MCW_Shield</li>

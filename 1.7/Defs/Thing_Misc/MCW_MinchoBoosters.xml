<Defs>
  <!-- ============================================================ -->
  <!-- 智慧珉巧改造包系列：物品 + 制作配方 + 手术配方               -->
  <!-- 所有改造包在珉巧工作台制作，使用时为 100% 成功率手术。       -->
  <!-- ============================================================ -->
  <!-- ===== 智慧珉巧改造包 ===== -->
  <ThingDef ParentName="ResourceBase">
    <defName>MCW_MinchoIntelBooster</defName>
    <label>Mincho intelligence booster</label>
    <description>A smart booster carefully prepared by Qinxintang. Tiny chips glitter in the syrup, lighting a new beam for thoughts that were once dim.</description>
    <graphicData>
      <texPath>Things/Item/MinchoIntelBooster</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <stackLimit>10</stackLimit>
    <statBases>
      <MarketValue>2000</MarketValue>
      <MaxHitPoints>100</MaxHitPoints>
      <Mass>0.5</Mass>
    </statBases>
    <thingCategories>
      <li>Manufactured</li>
    </thingCategories>
  </ThingDef>

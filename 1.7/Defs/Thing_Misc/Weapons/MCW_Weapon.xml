<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BaseMeleeWeapon_Sharp_Quality">
    <defName>MCW_MW_CandyCane</defName>
    <label>薄荷拐杖糖</label>
    <description>锐利的糖！锐利的拐!可以让小看这跟拐杖糖的人吃到足够的“甜头”。</description>
    <possessionCount>1</possessionCount>
    <graphicData>
      <texPath>Things/Item/CandyCane</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <ignoreThingDrawColor>true</ignoreThingDrawColor>
    </graphicData>
    <techLevel>Medieval</techLevel>
    <weaponTags>
      <li>MedievalMeleeAdvanced</li>
      <li>LongSword</li>
    </weaponTags>
    <costStuffCount>50</costStuffCount>
    <statBases>
      <WorkToMake>18000</WorkToMake>
      <Mass>2</Mass>
    </statBases>
    <relicChance>2</relicChance>
    <equippedAngleOffset>-65</equippedAngleOffset>
    <stuffCategories Inherit="False">
      <li>Metallic</li>
    </stuffCategories>
    <tools>
      <li>
        <label>handle</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>11.7</power>
        <cooldownTime>2</cooldownTime>
      </li>
      <li>
        <label>point</label>
        <capacities>
          <li>Stab</li>
        </capacities>
        <power>29.9</power>
        <cooldownTime>2.6</cooldownTime>
      </li>
      <li>
        <label>edge</label>
        <capacities>
          <li>Cut</li>
        </capacities>
        <power>29.9</power>
        <cooldownTime>2.6</cooldownTime>
      </li>
    </tools>
    <recipeMaker>
      <skillRequirements>
        <Crafting>5</Crafting>
      </skillRequirements>
      <displayPriority>420</displayPriority>
      <recipeUsers Inherit="False">
        <li>Mincho_MinchoBench</li>
      </recipeUsers>
    </recipeMaker>
    <costList Inherit="False">
      <Mincho_MintCandy>10</Mincho_MintCandy>
    </costList>
    <uiIconPath>Things/Item/CandyCane</uiIconPath>
  </ThingDef>

  <ThingDef ParentName="BaseHumanMakeableGun" Name="MCW_RW_VrocanGatling">
    <defName>MCW_RW_VrocanGatling</defName>
    <label>涡轮棒棒糖发射器</label>
    <description>强大的高科技产物，千机糖模仿人类机枪制作的棒棒糖发射器，可以发射出美味的棒棒糖，不过听说容易让坏人患上急性棒棒糖中毒。</description>
    <graphicData>
      <texPath>Things/Weapon/MCW_VrocanGatling</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>2.275</drawSize>
    </graphicData>
    <soundInteract>Interact_Rifle</soundInteract>
    <thingSetMakerTags>
      <li>RewardStandardQualitySuper</li>
    </thingSetMakerTags>
    <weaponClasses>
      <li>RangedHeavy</li>
    </weaponClasses>
    <statBases>
      <WorkToMake>60000</WorkToMake>
      <Mass>10</Mass>
      <AccuracyTouch>0.2</AccuracyTouch>
      <AccuracyShort>0.25</AccuracyShort>
      <AccuracyMedium>0.25</AccuracyMedium>
      <AccuracyLong>0.18</AccuracyLong>
      <RangedWeapon_Cooldown>1.5</RangedWeapon_Cooldown>
    </statBases>
    <costList>
      <Steel>300</Steel>
      <Mincho_MintCandy>40</Mincho_MintCandy>
      <ComponentIndustrial>20</ComponentIndustrial>
    </costList>
    <recipeMaker>
      <researchPrerequisite Inherit="false" />
      <recipeUsers Inherit="false">
        <li>Mincho_MinchoBench</li>
      </recipeUsers>
      <skillRequirements>
        <Crafting>7</Crafting>
      </skillRequirements>
      <displayPriority>450</displayPriority>
    </recipeMaker>
    <techLevel>Industrial</techLevel>
    <!-- <weaponTags>
      <li>GunHeavy</li>
      <li>Minigun</li>
    </weaponTags> -->
    <equippedStatOffsets>
      <MoveSpeed>-0.25</MoveSpeed>
    </equippedStatOffsets>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>MCW_VrocanGatling_Bullet</defaultProjectile>
        <warmupTime>2.5</warmupTime>
        <range>30.9</range>
        <burstShotCount>30</burstShotCount>
        <ticksBetweenBurstShots>10</ticksBetweenBurstShots>
        <soundCast>Shot_Minigun</soundCast>
        <soundCastTail>GunTail_Medium</soundCastTail>
        <muzzleFlashScale>9</muzzleFlashScale>
      </li>
    </verbs>
    <tools>
      <li>
        <label>barrels</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>11.7</power>
        <cooldownTime>2.6</cooldownTime>
      </li>
    </tools>
  </ThingDef>
  <ThingDef ParentName="BaseBullet">
    <defName>MCW_VrocanGatling_Bullet</defName>
    <label>棒棒糖</label>
    <graphicData>
      <texPath>Projectile/VrocanGatlingBullet</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(0.3691107,0.3691107)</drawSize>
    </graphicData>
    <projectile>
      <damageDef>Bullet</damageDef>
      <damageAmountBase>15</damageAmountBase>
      <speed>70</speed>
      <armorPenetrationBase>0.3</armorPenetrationBase>
    </projectile>
    <comps>
      <li Class="MinchoCandyWars.Projectiles.CompProperties_CandyTrail" />
    </comps>
  </ThingDef>
  <ThingDef ParentName="MCW_RW_VrocanGatling">
    <defName>MCW_RW_VrocanGatling_Formech</defName>
    <tradeability>None</tradeability>
    <destroyOnDrop>true</destroyOnDrop>
    <weaponTags>
      <li>MCW_RW_VrocanGatling_Formech</li>
    </weaponTags>
    <recipeMaker Inherit="False" IsNull="True" />
  </ThingDef>


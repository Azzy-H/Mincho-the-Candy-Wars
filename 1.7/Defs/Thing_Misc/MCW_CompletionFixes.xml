<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="ApparelNoQualityBase">
    <defName>MCW_Paralyzer</defName>
    <label>珉巧瘫痪器</label>
    <description>闪耀世界甜品公司的回收装备。仅对没有糖饰的珉巧有效：意识上限降至10%，持续一天。可使用两次，用尽后销毁。回收队员可能携带；太空级及以上据点低概率出售。</description>
    <graphicData>
      <texPath>Things/Item/Paralyzer</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <techLevel>Spacer</techLevel>
    <statBases>
      <Mass>0.5</Mass>
      <EquipDelay>1</EquipDelay>
      <MarketValue>550</MarketValue>
      <MaxHitPoints>80</MaxHitPoints>
    </statBases>
    <tickerType>Normal</tickerType>
    <thingCategories>
      <li>ApparelUtility</li>
    </thingCategories>
    <apparel>
      <countsAsClothingForNudity>false</countsAsClothingForNudity>
      <scoreOffset>4</scoreOffset>
      <careIfWornByCorpse>false</careIfWornByCorpse>
      <careIfDamaged>false</careIfDamaged>
      <ignoredByNonViolent>true</ignoredByNonViolent>
      <wearPerDay>0</wearPerDay>
      <bodyPartGroups>
        <li>Waist</li>
      </bodyPartGroups>
      <layers>
        <li>Belt</li>
      </layers>
      <wornGraphicPath>Things/Item/Paralyzer</wornGraphicPath>
      <wornGraphicData>
        <renderUtilityAsPack>true</renderUtilityAsPack>
        <north>
          <scale>(0.7,0.7)</scale>
        </north>
        <south>
          <offset>(0,0.4)</offset>
          <scale>(0.7,0.7)</scale>
        </south>
        <east>
          <offset>(-0.35,0)</offset>
          <scale>(0.85,0.85)</scale>
          <thin>
            <offset>(0,0.1)</offset>
          </thin>
          <hulk>
            <offset>(-0.15,0)</offset>
          </hulk>
          <fat>
            <offset>(-0.15,0)</offset>
          </fat>
          <male>
            <offset>(0,0.1)</offset>
          </male>
        </east>
        <west>
          <offset>(0.35,0)</offset>
          <scale>(0.85,0.85)</scale>
          <thin>
            <offset>(0,0.1)</offset>
          </thin>
          <hulk>
            <offset>(0.15,0)</offset>
          </hulk>
          <fat>
            <offset>(0.15,0)</offset>
          </fat>
          <male>
            <offset>(0,0.1)</offset>
          </male>
        </west>
      </wornGraphicData>
    </apparel>
    <resourceReadoutPriority>Middle</resourceReadoutPriority>
    <tradeNeverStack>true</tradeNeverStack>
    <smeltable>false</smeltable>
    <burnableByRecipe>false</burnableByRecipe>
    <drawGUIOverlay>false</drawGUIOverlay>
    <relicChance>3</relicChance>
    <verbs>
      <li>
        <verbClass>MinchoCandyWars.Review.Verb_Paralyzer</verbClass>
        <label>瘫痪珉巧</label>
        <hasStandardCommand>true</hasStandardCommand>
        <targetable>true</targetable>
        <onlyManualCast>True</onlyManualCast>
        <range>41.9</range>
        <warmupTime>2.2</warmupTime>
        <invalidTargetPawn>只能对没有糖饰的珉巧使用</invalidTargetPawn>
        <targetParams>
          <canTargetBuildings>false</canTargetBuildings>
          <neverTargetIncapacitated>true</neverTargetIncapacitated>
          <canTargetHumans>true</canTargetHumans>
          <canTargetAnimals>false</canTargetAnimals>
          <canTargetMechs>false</canTargetMechs>
        </targetParams>
        <soundCast>PsychicShockLanceCast</soundCast>
        <soundAiming>PsychicArtifactWarmupSustained</soundAiming>
      </li>
    </verbs>
    <comps>
      <li Class="CompProperties_ApparelReloadable">
        <maxCharges>2</maxCharges>
        <destroyOnEmpty>true</destroyOnEmpty>
        <hotKey>Misc4</hotKey>
        <chargeNoun>charge</chargeNoun>
        <displayGizmoWhileUndrafted>false</displayGizmoWhileUndrafted>
      </li>
      <li>
        <compClass>MinchoCandyWars.Review.ParalyzerEffect</compClass>
      </li>
      <li Class="CompProperties_TargetEffect_GoodwillImpact">
        <goodwillImpact>-200</goodwillImpact>
      </li>
      <li Class="CompProperties_TargetEffect_FleckOnTarget">
        <fleckDef>PsycastPsychicEffect</fleckDef>
      </li>
      <li Class="CompProperties_TargetEffect_FleckConnecting">
        <fleckDef>PsycastPsychicLine</fleckDef>
      </li>
      <li Class="CompProperties_Styleable" />
    </comps>
    <allowedArchonexusCount>1</allowedArchonexusCount>
  </ThingDef>
  <HediffDef>
    <defName>MCW_Paralyzed047</defName>
    <label>珉巧瘫痪</label>
    <description>回收用瘫痪器抑制了珉巧的意识。一日后解除。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>60000</disappearsAfterTicks>
      </li>
    </comps>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.1</setMax>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>
  <FleckDef ParentName="FleckBase">
    <defName>MCW_CandyTrail047</defName>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <solidTime>0</solidTime>
    <fadeOutTime>0.08</fadeOutTime>
    <graphicData>
      <texPath>Things/Mote/LineEMP</texPath>
      <shaderType>TransparentPostLight</shaderType>
      <color>(0.65,0.95,1,0.65)</color>
      <renderInstanced>true</renderInstanced>
    </graphicData>
  </FleckDef>
</Defs>
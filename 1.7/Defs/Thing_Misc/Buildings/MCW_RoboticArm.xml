<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ============================================================
       饼干操作臂
       设定来源：!!AgentWorkZone!!/糖果大作战贴图需求和物品简易设定（鲨雕）.docx
         描述：用美味的曲奇饼凑成一个机械臂的形状，可以让附近的工作台
               免于因温度降低而降低工作速度。
         制作：美味曲奇饼x10  薄荷冰淇淋x60  零部件x1

       温度机制：复用合作者实现的格子温度覆盖系统
         （MinchoCandyWars.Buildings.CompProperties_CellTemperatureOverride
           + Patch_GenTemperature，床也在用它）。
       本建筑把自身为中心、半径 radius 格内的格子温度恒定覆盖为
       temperature，处于该范围内的 pawn 不会因环境低温而工作变慢。
       ============================================================ -->
  <ThingDef ParentName="BuildingBase">
    <defName>MCW_RoboticArm</defName>
    <label>饼干操作臂</label>
    <description>用美味的曲奇饼凑成一个机械臂的形状，可以让附近的工作台免于因温度降低而降低工作速度。</description>
    <thingClass>Building</thingClass>
    <!--========== Graphic Data ==========-->
    <graphicData>
      <texPath>Things/Building/Misc/MCW_Robotic_Arm</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shadowData>
        <volume>(0.25, 0.35, 0.25)</volume>
        <offset>(0,0,-0.1)</offset>
      </shadowData>
    </graphicData>
    <tickerType>Normal</tickerType>
    <altitudeLayer>Building</altitudeLayer>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsMisc</li>
    </thingCategories>
    <!--========== Stat Base（占位数值） ==========-->
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <WorkToBuild>2000</WorkToBuild>
      <Mass>8</Mass>
      <Flammability>0.5</Flammability>
      <Beauty>2</Beauty>
    </statBases>
    <fillPercent>0.30</fillPercent>
    <size>(1,1)</size>
    <!--========== Crafting ==========-->
    <costList>
      <MCW_Delicious_Cookies>10</MCW_Delicious_Cookies>
      <Mincho_Mintchoco>60</Mincho_Mintchoco>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
    <pathCost>30</pathCost>
    <passability>PassThroughOnly</passability>
    <designationCategory>Mincho_Furniture</designationCategory>
    <uiOrder>2100</uiOrder>
    <rotatable>true</rotatable>
    <constructionSkillPrerequisite>5</constructionSkillPrerequisite>
    <!--========== Comps（半径内温度恒定，保护附近工作台） ==========-->
    <comps>
      <li Class="MinchoCandyWars.Buildings.CompProperties_CellTemperatureOverride">
        <temperature>21</temperature>
        <radius>2</radius>
      </li>
    </comps>
  </ThingDef>

</Defs>

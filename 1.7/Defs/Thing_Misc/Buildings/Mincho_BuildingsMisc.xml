<Defs>
  <!-- 灭火器 -->
  <ThingDef ParentName="BuildingBase">
    <defName>MCW_FirefoamPopper</defName>
    <label>Mint chocolate reusable firefoam popper</label>
    <description>A firefoam device clad in a mint chocolate shell. Idle, it looks like an unremarkable dessert ornament; when flame draws near it floods the area with foam without hesitation.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Things/Building/Misc/MCW_FirefoamPopper</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shadowData>
        <volume>(0.25, 0.35, 0.25)</volume>
        <offset>(0,0,-0.1)</offset>
      </shadowData>
      <damageData>
        <rect>(0.2,0.2,0.6,0.6)</rect>
      </damageData>
    </graphicData>
    <tickerType>Normal</tickerType>
    <altitudeLayer>Building</altitudeLayer>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsMisc</li>
    </thingCategories>
    <statBases>
      <MaxHitPoints>50</MaxHitPoints>
      <WorkToBuild>1500</WorkToBuild>
      <Mass>10</Mass>
      <Flammability>1.0</Flammability>
      <Beauty>5</Beauty>
    </statBases>
    <fillPercent>0.30</fillPercent>
    <costList Inherit="False">
      <Mincho_ChocoStick>10</Mincho_ChocoStick>
      <Mincho_Mintchoco>50</Mincho_Mintchoco>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
    <specialDisplayRadius>9.9</specialDisplayRadius>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <pathCost>30</pathCost>
    <passability>PassThroughOnly</passability>
    <designationCategory>Mincho_Furniture</designationCategory>
    <uiOrder>2070</uiOrder>
    <rotatable>true</rotatable>
    <designationHotKey>Misc7</designationHotKey>
    <!-- <researchPrerequisites>

      <li>Firefoam</li>

    </researchPrerequisites> -->
    <constructionSkillPrerequisite>5</constructionSkillPrerequisite>
    <comps>
      <li Class="CompProperties_Explosive">
        <explosiveRadius>9.9</explosiveRadius>
        <explosiveDamageType>Extinguish</explosiveDamageType>
        <startWickHitPointsPercent>-1</startWickHitPointsPercent>
        <startWickOnDamageTaken>
          <li>Flame</li>
        </startWickOnDamageTaken>
        <postExplosionSpawnThingDef>Filth_FireFoam</postExplosionSpawnThingDef>
        <postExplosionSpawnChance>1</postExplosionSpawnChance>
        <postExplosionSpawnThingCount>1</postExplosionSpawnThingCount>
        <applyDamageToExplosionCellsNeighbors>true</applyDamageToExplosionCellsNeighbors>
        <explosionEffect>ExtinguisherExplosion</explosionEffect>
        <explosionSound>Explosion_FirefoamPopper</explosionSound>
        <destroyThingOnExplosionSize>1000</destroyThingOnExplosionSize>
        <explodeOnKilled>false</explodeOnKilled>
      </li>
      <li Class="CompProperties_Usable">
        <useJob>TriggerObject</useJob>
        <useLabel>Trigger {0_label}</useLabel>
      </li>
      <li Class="CompProperties_UseEffect">
        <compClass>CompUseEffect_StartWick</compClass>
      </li>
      <li Class="CompProperties_ProximityFuse">
        <target>Fire</target>
        <radius>5</radius>
      </li>
      <li Class="CompProperties_Refuelable">
        <fuelCapacity>50</fuelCapacity>
        <initialFuelPercent>1</initialFuelPercent>
        <fuelConsumptionRate>0</fuelConsumptionRate>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
        <atomicFueling>true</atomicFueling>
        <allowRefuelIfNotEmpty>false</allowRefuelIfNotEmpty>
        <minimumFueledThreshold>50</minimumFueledThreshold>
        <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
        <fuelLabel>Mint ice cream</fuelLabel>
        <fuelGizmoLabel>Firefoam charge</fuelGizmoLabel>
        <outOfFuelMessage>Requires 50 mint ice cream to refill</outOfFuelMessage>
        <fuelFilter>
          <thingDefs>
            <li>Mincho_Mintchoco</li>
          </thingDefs>
        </fuelFilter>
      </li>
    </comps>
  </ThingDef>

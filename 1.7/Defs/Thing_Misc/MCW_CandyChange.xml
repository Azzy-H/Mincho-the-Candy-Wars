  <!-- ===================== 制作配方 ===================== -->
  <RecipeDef>
    <defName>MCW_Make_MechaCandyChangeItem</defName>
    <label>Make Mecha Candy ornament</label>
    <description>Make the mecha candy ornament unlock item.</description>
    <jobString>Making Mecha Candy unlock item.</jobString>
    <workAmount>8000</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>Smith</effectWorking>
    <soundWorking>Recipe_Drug</soundWorking>
    <researchPrerequisite>MCW_Research_MechaCandy</researchPrerequisite>
    <recipeUsers>
      <li>Mincho_MinchoBench</li>
    </recipeUsers>
    <ingredients>
      <li MayRequire="Ludeon.RimWorld.Biotech">
        <filter>
          <thingDefs>
            <li>ArchiteCapsule</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Mincho_Mintchoco</li>
            <li>Mincho_BluePolarBear</li>
            <li>Mincho_PinkFallInLove</li>
          </thingDefs>
        </filter>
        <count>50</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>ComponentIndustrial</li>
          </thingDefs>
        </filter>
        <count>3</count>
      </li>
    </ingredients>
    <products>
      <MCW_MechaCandyChangeItem>1</MCW_MechaCandyChangeItem>
    </products>
    <workSkill>Crafting</workSkill>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Mincho_Mintchoco</li>
        <li>Mincho_BluePolarBear</li>
        <li>Mincho_PinkFallInLove</li>
        <li>ComponentIndustrial</li>
        <li MayRequire="Ludeon.RimWorld.Biotech">ArchiteCapsule</li>
      </thingDefs>
    </fixedIngredientFilter>
    <allowMixingIngredients>true</allowMixingIngredients>
  </RecipeDef>

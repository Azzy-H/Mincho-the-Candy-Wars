  <!-- ===== 千机糖解锁物品 ===== -->
  <ThingDef ParentName="ResourceBase">
    <defName>MCW_MechaCandyChangeItem</defName>
    <label>Mecha Candy ornament</label>
    <description>The delicate ornament left by the mecha candy; countless tiny gears seem to hide in its cool patterns. The low hum of machinery is the melody she knows best.</description>
    <graphicData>
      <texPath>Things/Item/Mecha</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <thingClass>ThingWithComps</thingClass>
    <comps>
      <li Class="CompProperties_Usable">
        <useJob>UseItem</useJob>
        <useLabel>Implant {0_label}</useLabel>
        <showUseGizmo>true</showUseGizmo>
      </li>
      <li Class="MinchoCandyWars.CompProperties_UseEffect_CandyChange">
        <candyType>MechaCandy</candyType>
      </li>
      <li Class="CompProperties_UseEffectDestroySelf">
        <orderPriority>-1000</orderPriority>
      </li>
    </comps>
    <stackLimit>10</stackLimit>
    <statBases>
      <MarketValue>1000</MarketValue>
      <MaxHitPoints>60</MaxHitPoints>
      <Mass>0.075</Mass>
      <Flammability>1</Flammability>
      <DeteriorationRate>8</DeteriorationRate>
    </statBases>
    <thingCategories>
      <li>Manufactured</li>
    </thingCategories>
  </ThingDef>

<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Biotech</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="MinchoWitch_MinchoGolem"]/comps</xpath>
          <match Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName="MinchoWitch_MinchoGolem"]/comps</xpath>
            <value>
              <li Class="MinchoCandyWars.Golem.CompProperties_GolemRemains" />
            </value>
          </match>
          <nomatch Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName="MinchoWitch_MinchoGolem"]</xpath>
            <value>
              <comps>
                <li Class="MinchoCandyWars.Golem.CompProperties_GolemRemains" />
              </comps>
            </value>
          </nomatch>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="LargeMechGestator"]/recipes</xpath>
          <value>
            <li>MCW_Mech_Golem_Recipe</li>
            <li>MCW_ResurrectGolem</li>
          </value>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>
<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!--
    纳米塑形动物：给 4 个动物种族加上交易标签，让 MCW_NanoAnimalSeller086 能备货。
    原先这段写在 C# 静态构造里（Startup），改成 XML 以保证加载顺序确定、并可在 DevMode 下查证。
  -->
  

  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="Mincho_Minmoong"]/tradeTags</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="Mincho_Minmoong"]/tradeTags</xpath>
      <value>
        <li>MCW_NanoShapedAnimal085</li>
      </value>
    </match>
    <nomatch Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="Mincho_Minmoong"]</xpath>
      <value>
        <tradeTags>
          <li>MCW_NanoShapedAnimal085</li>
        </tradeTags>
      </value>
    </nomatch>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="Mincho_Minchonyang"]/tradeTags</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="Mincho_Minchonyang"]/tradeTags</xpath>
      <value>
        <li>MCW_NanoShapedAnimal085</li>
      </value>
    </match>
    <nomatch Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="Mincho_Minchonyang"]</xpath>
      <value>
        <tradeTags>
          <li>MCW_NanoShapedAnimal085</li>
        </tradeTags>
      </value>
    </nomatch>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="Mincho_MinchoLatteIsHorse"]/tradeTags</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="Mincho_MinchoLatteIsHorse"]/tradeTags</xpath>
      <value>
        <li>MCW_NanoShapedAnimal085</li>
      </value>
    </match>
    <nomatch Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="Mincho_MinchoLatteIsHorse"]</xpath>
      <value>
        <tradeTags>
          <li>MCW_NanoShapedAnimal085</li>
        </tradeTags>
      </value>
    </nomatch>
  </Operation>

  <!--
    把纳米动物商人加进珉巧派系的商队类型。
    注意：Mincho_Faction 的 baseTraderKinds 是从 Abstract 父类 MinchoFactionBase 继承来的，
    XML 原文里并没有这个节点，所以不能直接 PatchOperationAdd 到 xpath，
    必须用 Conditional 分支：有就追加，没有就在 FactionDef 下新建完整列表。
  -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/FactionDef[defName="Mincho_Faction"]/baseTraderKinds</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/FactionDef[defName="Mincho_Faction"]/baseTraderKinds</xpath>
      <value>
        <li>MCW_NanoAnimalSeller086</li>
      </value>
    </match>
    <nomatch Class="PatchOperationAdd">
      <xpath>Defs/FactionDef[defName="Mincho_Faction"]</xpath>
      <value>
        <baseTraderKinds>
          <li>Base_Outlander_Standard</li>
          <li>MCW_NanoAnimalSeller086</li>
        </baseTraderKinds>
      </value>
    </nomatch>
  </Operation>
</Patch>

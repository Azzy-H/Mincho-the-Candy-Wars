<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/AlienRace.ThingDef_AlienRace[defName="Mincho_ThingDef"]/comps</xpath>
    <value>
      <li Class="MinchoCandyWars.CompProperties_MinchoCore">
          <renderNodeProperties>
            <li>
              <debugLabel>MCW candy decoration</debugLabel>
              <nodeClass>MinchoCandyWars.Render.PawnRenderNode_CandyDecoration</nodeClass>
              <workerClass>MinchoCandyWars.Render.PawnRenderNodeWorker_CandyDecoration</workerClass>
              <useGraphic>true</useGraphic>
              <parentTagDef>Head</parentTagDef>
              <baseLayer>66</baseLayer>
              <drawSize>0.675,0.675</drawSize>
            </li>
          </renderNodeProperties>
        </li>
      <li Class="MinchoCandyWars.Buff.CompProperties_MinchoCandyBuffApply" />
    </value>
  </Operation>

  

  <!-- 为每个 CompProperties_ResourceHarvestable 添加 productAffectedStats -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/AlienRace.ThingDef_AlienRace[defName="Mincho_ThingDef"]/comps/li[@Class="Mincho_HPF.CompProperties_ResourceHarvestable"]</xpath>
    <value>
      <productAffectedStats>
        <li>
          <statDef>MCW_IceCreamOutput</statDef>
          <multiplier>20</multiplier>
        </li>
      </productAffectedStats>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/AlienRace.ThingDef_AlienRace[defName="Mincho_ThingDef"]</xpath>
    <value>
      <killedLeavingsRanges />
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/AlienRace.ThingDef_AlienRace[defName="Mincho_ThingDef"]/killedLeavingsRanges</xpath>
    <value>
      <MCW_Beta_NanoShapingFluid>-8~1</MCW_Beta_NanoShapingFluid>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/HediffGiverSetDef[defName="Mincho_HediffGiver"]/hediffGivers</xpath>
    <value>
      <li Class="MinchoCandyWars.HediffGiver_Mincho">
        <hediff>MCW_SnowBoost</hediff>
      </li>
    </value>
  </Operation>

</Patch>
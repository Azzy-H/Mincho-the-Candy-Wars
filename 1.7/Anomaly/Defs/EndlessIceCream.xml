<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef>
    <defName>MCW_EndlessIceCream</defName>
    <label>无尽薄荷冰淇淋桶</label>
    <description>一桶始终装满的薄荷冰淇淋。吃掉的部分很快就会重新出现。它带来的满足感令人难以忘怀，其他食物却逐渐变得难以下咽。\n\n研究它或许能找到解除影响的方法。珉巧似乎不受这些影响。</description>
    <thingClass>MinchoCandyWars.Anomaly.EndlessBucket</thingClass>
    <category>Item</category>
    <genericMarketSellable>false</genericMarketSellable>
    <drawerType>MapMeshOnly</drawerType>
    <tickerType>Normal</tickerType>
    <rotatable>false</rotatable>
    <altitudeLayer>Item</altitudeLayer>
    <selectable>true</selectable>
    <useHitPoints>false</useHitPoints>
    <alwaysHaulable>true</alwaysHaulable>
    <drawGUIOverlay>true</drawGUIOverlay>
    <pathCost>14</pathCost>
    <stackLimit>1</stackLimit>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>Things/Item/Anomaly/EndlessIceCream</texPath>
      <drawSize>(0.65,1)</drawSize>
    </graphicData>
    <statBases>
      <Mass>1</Mass>
      <Beauty>400</Beauty>
      <Flammability>0</Flammability>
      <MarketValue>1200</MarketValue>
      <Nutrition>1</Nutrition>
      <FoodPoisonChanceFixedHuman>0</FoodPoisonChanceFixedHuman>
    </statBases>
    <thingCategories>
      <li>Foods</li>
    </thingCategories>
    <inspectorTabs>
      <li>ITab_StudyNotes</li>
    </inspectorTabs>
    <allowedArchonexusCount>1</allowedArchonexusCount>
    <ingestible>
      <foodType>Processed</foodType>
      <preferability>MealFine</preferability>
      <maxNumToIngestAtOnce>1</maxNumToIngestAtOnce>
      <baseIngestTicks>500</baseIngestTicks>
      <chairSearchRadius>8</chairSearchRadius>
      <ingestSound>Ingest_Eat</ingestSound>
    </ingestible>
    <comps>
      <li Class="CompProperties_Forbiddable"/>
      <li Class="CompProperties_Studiable">
        <frequencyTicks>120000</frequencyTicks>
        <knowledgeCategory>Advanced</knowledgeCategory>
        <anomalyKnowledge>2</anomalyKnowledge>
        <minMonolithLevelForStudy>1</minMonolithLevelForStudy>
        <showToggleGizmo>true</showToggleGizmo>
      </li>
      <li Class="CompProperties_StudyUnlocks">
        <studyNotes>
          <li>
            <threshold>4</threshold>
            <label>无尽冰淇淋桶：研究进展</label>
            <text>{PAWN_nameDef}发现，这桶冰淇淋会改变食用者对食物的感受。受影响的人很快就会渴望再次吃到薄荷冰淇淋，并开始厌恶其他食物。珉巧似乎能够抵抗这种影响。</text>
          </li>
          <li>
            <thresholdRange>24~40</thresholdRange>
            <label>无尽冰淇淋桶：研究完成</label>
            <text>{PAWN_nameDef}找到了切断精神影响的方法。一个超凡碎片足以解除这桶冰淇淋造成的依赖。冰淇淋仍会再生，但每次食用只能获得原先五分之一的营养。\n\n选中冰淇淋桶即可解除影响。</text>
          </li>
        </studyNotes>
      </li>
      <li Class="MinchoCandyWars.Anomaly.BucketReleaseProperties">
        <activeTicks>1</activeTicks>
        <ticksToActivate>540</ticksToActivate>
        <activateTexPath>Things/Item/Anomaly/DeactivateEndlessIceCream</activateTexPath>
        <activateLabelString>解除精神影响</activateLabelString>
        <activateDescString>消耗1个碎片，解除这桶冰淇淋造成的依赖。冰淇淋仍可食用，每次提供0.2营养。</activateDescString>
        <guiLabelString>选择执行者</guiLabelString>
        <jobString>解除精神影响</jobString>
        <activatingStringPending>正在解除{0}的影响</activatingStringPending>
        <activatingString>正在解除{0}的影响：{1}秒</activatingString>
        <targetingParameters>
          <canTargetBuildings>false</canTargetBuildings>
          <canTargetAnimals>false</canTargetAnimals>
          <canTargetMechs>false</canTargetMechs>
          <onlyTargetControlledPawns>true</onlyTargetControlledPawns>
        </targetingParameters>
      </li>
    </comps>
  </ThingDef>

  <!--
    已解除精神影响的版本：独立 Def，营养固定为 0.2，不带研究组件、也不带解除交互。
    "解除影响"由 BucketRelease 把原桶销毁并换成这一版完成，
    因此运行时不再需要 neutralized 状态，也不需要 Nutrition 的 StatPart。
  -->
  <ThingDef>
    <defName>MCW_EndlessIceCream_Released</defName>
    <label>无尽薄荷冰淇淋桶（已解除影响）</label>
    <description>精神影响已经解除的无尽冰淇淋桶。它依然取之不尽，但每次食用只能提供五分之一的营养，也不再让人上瘾。</description>
    <thingClass>MinchoCandyWars.Anomaly.ReleasedBucket</thingClass>
    <category>Item</category>
    <genericMarketSellable>false</genericMarketSellable>
    <drawerType>MapMeshOnly</drawerType>
    <rotatable>false</rotatable>
    <altitudeLayer>Item</altitudeLayer>
    <selectable>true</selectable>
    <useHitPoints>false</useHitPoints>
    <alwaysHaulable>true</alwaysHaulable>
    <drawGUIOverlay>true</drawGUIOverlay>
    <pathCost>14</pathCost>
    <stackLimit>1</stackLimit>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>Things/Item/Anomaly/EndlessIceCream</texPath>
      <drawSize>(0.65,1)</drawSize>
    </graphicData>
    <statBases>
      <Mass>1</Mass>
      <Beauty>400</Beauty>
      <Flammability>0</Flammability>
      <MarketValue>1200</MarketValue>
      <Nutrition>0.2</Nutrition>
      <FoodPoisonChanceFixedHuman>0</FoodPoisonChanceFixedHuman>
    </statBases>
    <thingCategories>
      <li>Foods</li>
    </thingCategories>
    <allowedArchonexusCount>1</allowedArchonexusCount>
    <ingestible>
      <foodType>Processed</foodType>
      <preferability>MealFine</preferability>
      <maxNumToIngestAtOnce>1</maxNumToIngestAtOnce>
      <baseIngestTicks>500</baseIngestTicks>
      <chairSearchRadius>8</chairSearchRadius>
      <ingestSound>Ingest_Eat</ingestSound>
    </ingestible>
    <comps>
      <li Class="CompProperties_Forbiddable"/>
    </comps>
  </ThingDef>

  <ChemicalDef>
    <defName>MCW_Mint</defName>
    <label>薄荷冰淇淋</label>
    <addictionHediff>MCW_MintAddiction</addictionHediff>
  </ChemicalDef>
  <NeedDef ParentName="DrugAddictionNeedBase">
    <defName>Chemical_MCW_Mint</defName>
    <needClass>Need_Chemical</needClass>
    <label>薄荷冰淇淋</label>
    <description>对薄荷冰淇淋的强烈渴望。不定期食用薄荷冰淇淋或相关制品就会感到痛苦。</description>
    <listPriority>25</listPriority>
    <fallPerDay>1</fallPerDay>
  </NeedDef>
  <HediffDef ParentName="AddictionBase">
    <defName>MCW_MintAddiction</defName>
    <label>薄荷冰淇淋依赖</label>
    <description>这桶冰淇淋改变了食用者的口味。不再吃薄荷冰淇淋，很快就会感到强烈的不适。研究冰淇淋桶可以找到解除影响的方法。</description>
    <hediffClass>MinchoCandyWars.Anomaly.MintAddiction</hediffClass>
    <chemicalNeed>Chemical_MCW_Mint</chemicalNeed>
    <scenarioCanAdd>false</scenarioCanAdd>
    <stages>
      <li/>
      <li>
        <label>戒断</label>
      </li>
    </stages>
  </HediffDef>
  <HediffDef>
    <defName>MCW_MintDaze</defName>
    <label>冰淇淋恍惚</label>
    <description>思绪被冰凉而甜蜜的满足感占据。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <isBad>true</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>60000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.2</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>
  <HediffDef>
    <defName>MCW_MintFreedom</defName>
    <label>冰淇淋影响已解除</label>
    <description>已经摆脱了无尽冰淇淋桶的精神影响。</description>
    <hediffClass>Hediff</hediffClass>
    <initialSeverity>1</initialSeverity>
    <isBad>false</isBad>
  </HediffDef>
  <ThoughtDef>
    <defName>MCW_MintWithdrawal</defName>
    <workerClass>MinchoCandyWars.Anomaly.MintWithdrawal</workerClass>
    <validWhileDespawned>true</validWhileDespawned>
    <stages>
      <li>
        <label>想吃薄荷冰淇淋</label>
        <description>我想吃薄荷冰淇淋。其他东西都不对味。</description>
        <baseMoodEffect>-20</baseMoodEffect>
      </li>
      <li>
        <label>薄荷冰淇淋戒断</label>
        <description>我受不了了。我需要薄荷冰淇淋，现在就要。</description>
        <baseMoodEffect>-40</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>MCW_MintDelight</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>1</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>薄荷冰淇淋的滋味</label>
        <description>冰凉，香甜。真好吃。</description>
        <baseMoodEffect>15</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>MCW_MintDisgust</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>1</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>难以下咽</label>
        <description>这不是我想吃的。我只想要薄荷冰淇淋。</description>
        <baseMoodEffect>-40</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <QuestScriptDef ParentName="MysteriousCargoBase">
    <defName>MCW_MintCargo</defName>
    <root Class="MinchoCandyWars.Anomaly.MintCargo"/>
    <questContentRules>
      <rulesStrings>
        <li>deliveredLetterLabel->神秘货物</li>
        <li>deliveredLetterText->神秘货物已经送达。箱子里是一桶薄荷冰淇淋。它始终保持冰凉，被取走的部分也会悄然恢复。\n\n你可以研究它，查明其中的原因。</li>
      </rulesStrings>
    </questContentRules>
  </QuestScriptDef>
  <IncidentDef ParentName="MysteriousIncidentCargoBase">
    <defName>MCW_MintCargo</defName>
    <label>神秘冰淇淋货物</label>
    <questScriptDef>MCW_MintCargo</questScriptDef>
  </IncidentDef>
</Defs>

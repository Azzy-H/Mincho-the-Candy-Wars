<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef>
    <defName>MCW_EndlessIceCream</defName>
    <label>Endless mint ice cream bucket</label>
    <description>A bucket of ice cream giving off a sweet mint scent. The barrel bears no production mark, and no sign of how it was sealed.</description>
    <thingClass>MinchoCandyWars.Anomaly.EndlessBucket</thingClass>
    <category>Item</category>
    <genericMarketSellable>false</genericMarketSellable>
    <drawerType>MapMeshOnly</drawerType>
    <tickerType>Normal</tickerType>
    <rotatable>false</rotatable>
    <altitudeLayer>Item</altitudeLayer>
    <selectable>true</selectable>
    <useHitPoints>false</useHitPoints>
    <alwaysHaulable>true</alwaysHaulable>
    <drawGUIOverlay>true</drawGUIOverlay>
    <pathCost>14</pathCost>
    <stackLimit>1</stackLimit>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>Things/Item/Anomaly/EndlessIceCream</texPath>
      <drawSize>(0.65,1)</drawSize>
    </graphicData>
    <statBases>
      <Mass>1</Mass>
      <Beauty>400</Beauty>
      <Flammability>0</Flammability>
      <MarketValue>1200</MarketValue>
      <Nutrition>1</Nutrition>
      <FoodPoisonChanceFixedHuman>0</FoodPoisonChanceFixedHuman>
    </statBases>
    <thingCategories>
      <li>Foods</li>
    </thingCategories>
    <inspectorTabs>
      <li>ITab_StudyNotes</li>
    </inspectorTabs>
    <allowedArchonexusCount>1</allowedArchonexusCount>
    <!-- socialPropernessMatters 是 ThingDef 的字段，不在 ingestible 内部 -->
    <socialPropernessMatters>true</socialPropernessMatters>
    <ingestible>
      <foodType>Processed</foodType>
      <preferability>MealFine</preferability>
      <maxNumToIngestAtOnce>1</maxNumToIngestAtOnce>
      <baseIngestTicks>500</baseIngestTicks>
      <chairSearchRadius>8</chairSearchRadius>
      <ingestSound>Meal_Eat</ingestSound>
    </ingestible>
    <comps>
      <li Class="MinchoCandyWars.Anomaly.BucketDiscoveryProperties" />
      <li Class="CompProperties_Forbiddable" />
      <li Class="CompProperties_Studiable">
        <frequencyTicks>120000</frequencyTicks>
        <knowledgeCategory>Advanced</knowledgeCategory>
        <anomalyKnowledge>2</anomalyKnowledge>
        <minMonolithLevelForStudy>1</minMonolithLevelForStudy>
        <showToggleGizmo>true</showToggleGizmo>
      </li>
      <li Class="CompProperties_StudyUnlocks">
        <studyNotes>
          <li>
            <threshold>4</threshold>
            <label>Endless ice cream bucket: research progress</label>
            <text>{PAWN_nameDef} has found that ice cream taken from the bucket reappears. The bucket also changes how those who eat from it feel about food. The affected soon crave mint ice cream again and begin to dislike other food. Mincho seem able to resist this effect.</text>
          </li>
          <li>
            <thresholdRange>24~40</thresholdRange>
            <label>Endless ice cream bucket: research complete</label>
            <text>{PAWN_nameDef} has found a way to sever the psychic influence. A single archotech shard is enough to break the dependence this bucket causes. The ice cream still regenerates, but each serving now provides only one fifth of its former nutrition.\n\nSelect the ice cream bucket to remove the influence.</text>
          </li>
        </studyNotes>
      </li>
      <li Class="MinchoCandyWars.Anomaly.BucketReleaseProperties">
        <activeTicks>1</activeTicks>
        <ticksToActivate>540</ticksToActivate>
        <activateTexPath>Things/Item/Anomaly/DeactivateEndlessIceCream</activateTexPath>
        <activateLabelString>Remove psychic influence</activateLabelString>
        <activateDescString>Consume 1 shard to break the dependence caused by this bucket. The ice cream remains edible and provides 0.2 nutrition per serving.</activateDescString>
        <guiLabelString>Select a worker</guiLabelString>
        <jobString>Remove psychic influence</jobString>
        <activatingStringPending>Removing the influence on {0}</activatingStringPending>
        <activatingString>Removing the influence on {0}: {1}s</activatingString>
        <targetingParameters>
          <canTargetBuildings>false</canTargetBuildings>
          <canTargetAnimals>false</canTargetAnimals>
          <canTargetMechs>false</canTargetMechs>
          <onlyTargetControlledPawns>true</onlyTargetControlledPawns>
        </targetingParameters>
      </li>
    </comps>
  </ThingDef>
  <!--
    已解除精神影响的版本：独立 Def，营养固定为 0.2，不带研究组件、也不带解除交互。
    "解除影响"由 BucketRelease 把原桶销毁并换成这一版完成，
    因此运行时不再需要 neutralized 状态，也不需要 Nutrition 的 StatPart。
  -->
  <ThingDef>
    <defName>MCW_EndlessIceCream_Released</defName>
    <label>Endless mint ice cream bucket (influence removed)</label>
    <description>That irresistible urge has dispersed, while the sweet mint scent inside is as it always was. Now it is just a dessert you can never finish, and which never quite fills you up.</description>
    <thingClass>MinchoCandyWars.Anomaly.ReleasedBucket</thingClass>
    <category>Item</category>
    <genericMarketSellable>false</genericMarketSellable>
    <drawerType>MapMeshOnly</drawerType>
    <rotatable>false</rotatable>
    <altitudeLayer>Item</altitudeLayer>
    <selectable>true</selectable>
    <useHitPoints>false</useHitPoints>
    <alwaysHaulable>true</alwaysHaulable>
    <drawGUIOverlay>true</drawGUIOverlay>
    <pathCost>14</pathCost>
    <stackLimit>1</stackLimit>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>Things/Item/Anomaly/EndlessIceCream</texPath>
      <drawSize>(0.65,1)</drawSize>
    </graphicData>
    <statBases>
      <Mass>1</Mass>
      <Beauty>400</Beauty>
      <Flammability>0</Flammability>
      <MarketValue>1200</MarketValue>
      <Nutrition>0.2</Nutrition>
      <FoodPoisonChanceFixedHuman>0</FoodPoisonChanceFixedHuman>
    </statBases>
    <thingCategories>
      <li>Foods</li>
    </thingCategories>
    <allowedArchonexusCount>1</allowedArchonexusCount>
    <!-- socialPropernessMatters 是 ThingDef 的字段，不在 ingestible 内部 -->
    <socialPropernessMatters>true</socialPropernessMatters>
    <ingestible>
      <foodType>Processed</foodType>
      <preferability>MealFine</preferability>
      <maxNumToIngestAtOnce>1</maxNumToIngestAtOnce>
      <baseIngestTicks>500</baseIngestTicks>
      <chairSearchRadius>8</chairSearchRadius>
      <ingestSound>Meal_Eat</ingestSound>
    </ingestible>
    <comps>
      <li Class="CompProperties_Forbiddable" />
    </comps>
  </ThingDef>
  <ChemicalDef>
    <defName>MCW_Mint</defName>
    <label>Mint ice cream</label>
    <addictionHediff>MCW_MintAddiction</addictionHediff>
  </ChemicalDef>
  <NeedDef ParentName="DrugAddictionNeedBase">
    <defName>Chemical_MCW_Mint</defName>
    <needClass>Need_Chemical</needClass>
    <label>Mint ice cream</label>
    <description>An intense craving for mint ice cream. Suffering follows if mint ice cream or related products are not eaten regularly.</description>
    <listPriority>25</listPriority>
    <fallPerDay>1</fallPerDay>
  </NeedDef>
  <HediffDef ParentName="AddictionBase">
    <defName>MCW_MintAddiction</defName>
    <label>Mint ice cream dependence</label>
    <description>This bucket changed the eater taste. Going without mint ice cream soon brings severe discomfort. Studying the bucket may reveal a way to break the influence.</description>
    <hediffClass>MinchoCandyWars.Anomaly.MintAddiction</hediffClass>
    <chemicalNeed>Chemical_MCW_Mint</chemicalNeed>
    <scenarioCanAdd>false</scenarioCanAdd>
    <stages>
      <li />
      <li>
        <label>Withdrawal</label>
      </li>
    </stages>
  </HediffDef>
  <HediffDef>
    <defName>MCW_MintDaze</defName>
    <label>Ice cream daze</label>
    <description>Thoughts are occupied by a cold, sweet contentment.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <isBad>true</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>60000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.2</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>
  <HediffDef>
    <defName>MCW_MintFreedom</defName>
    <label>Ice cream influence removed</label>
    <description>Free of the psychic influence of the endless ice cream bucket.</description>
    <hediffClass>Hediff</hediffClass>
    <initialSeverity>1</initialSeverity>
    <isBad>false</isBad>
    <stages>
      <li><becomeVisible>false</becomeVisible></li>
    </stages>
  </HediffDef>
  <ThoughtDef>
    <defName>MCW_MintWithdrawal</defName>
    <workerClass>MinchoCandyWars.Anomaly.ThoughtWorker_MintWithdrawal</workerClass>
    <validWhileDespawned>true</validWhileDespawned>
    <stages>
      <li>
        <label>Craving mint ice cream</label>
        <description>I want mint ice cream. Nothing else tastes right.</description>
        <baseMoodEffect>-20</baseMoodEffect>
      </li>
      <li>
        <label>Mint ice cream withdrawal</label>
        <description>I cannot stand it. I need mint ice cream, now.</description>
        <baseMoodEffect>-40</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>MCW_MintDelight</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>1</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>The taste of mint ice cream</label>
        <description>Cold and sweet. Delicious.</description>
        <baseMoodEffect>15</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>MCW_MintDisgust</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>1</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>Hard to swallow</label>
        <description>This is not what I want. I only want mint ice cream.</description>
        <baseMoodEffect>-40</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <QuestScriptDef ParentName="MysteriousCargoBase">
    <defName>MCW_MintCargo</defName>
    <root Class="MinchoCandyWars.Anomaly.MintCargo" />
    <questContentRules>
      <rulesStrings>
        <li>deliveredLetterLabel-&gt;Mysterious cargo</li>
        <li>deliveredLetterText-&gt;The mysterious cargo has arrived. Inside the crate is a bucket of mint ice cream. It stays cold at all times, and whatever is taken from it quietly returns.\n\nYou can study it to find out why.</li>
      </rulesStrings>
    </questContentRules>
  </QuestScriptDef>
  <IncidentDef ParentName="MysteriousIncidentCargoBase">
    <defName>MCW_MintCargo</defName>
    <label>Mysterious ice cream cargo</label>
    <questScriptDef>MCW_MintCargo</questScriptDef>
  </IncidentDef>
</Defs>

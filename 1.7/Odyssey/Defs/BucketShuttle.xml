<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>MCW_BucketShuttle</defName>
    <label>珉巧冰淇淋桶飞行器</label>
    <description>一桶能飞行的巨型冰淇淋。可装载乘员和货物，沿用载客穿梭机的操作和驾驶要求。

补给：薄荷巧克力、蓝色北极熊或粉色寻爱者冰淇淋，每份提供1点动力，可混合补给。容量1000份；每格消耗2份，最低单程消耗35份；单次航程上限56格（约为穿梭机的90%）。停放不消耗。

冰淇淋加入后作为混合动力储备，无法取回。</description>
    <thingClass>Building_PassengerShuttle</thingClass>
    <preventDroppingThingsOn>true</preventDroppingThingsOn>
    <altitudeLayer>Building</altitudeLayer>
    <pathCost>50</pathCost>
    <blockWind>true</blockWind>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.5</fillPercent>
    <size>(4,4)</size>
    <drawHighlight>true</drawHighlight>
    <highlightColor>(0.56, 0.62, 0.9)</highlightColor>
    <uiIconScale>1</uiIconScale>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <drawRotated>false</drawRotated>
      <texPath>Things/Building/BucketShuttle/Bucket</texPath>
      <shaderType>Cutout</shaderType>
      <drawSize>(4,4)</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>600</MaxHitPoints>
      <Flammability>0.5</Flammability>
      <WorkToBuild>36000</WorkToBuild>
      <Mass>125</Mass>
      <Comfort>0.65</Comfort>
    </statBases>
    <tickerType>Normal</tickerType>
    <designationCategory>Mincho_Furniture</designationCategory>
    <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
    <costList>
      <Mincho_BlocksMintchoco>1200</Mincho_BlocksMintchoco>
      <Plasteel>150</Plasteel>
      <ComponentIndustrial>6</ComponentIndustrial>
      <ShuttleEngine>1</ShuttleEngine>
    </costList>
    <canOverlapZones>true</canOverlapZones>
    <killedLeavings>
      <Steel>50</Steel>
      <Plasteel>50</Plasteel>
      <ChunkSlagSteel>4</ChunkSlagSteel>
      <ComponentIndustrial>3</ComponentIndustrial>
    </killedLeavings>
    <rotatable>false</rotatable>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,3)</interactionCellOffset>
    <defaultPlacingRot>South</defaultPlacingRot>
    <selectable>true</selectable>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
    <preventSkyfallersLandingOn>true</preventSkyfallersLandingOn>
    <drawerType>RealtimeOnly</drawerType>
    <repairEffect>ConstructMetal</repairEffect>
    <forceDebugSpawnable>true</forceDebugSpawnable>
    <building>
      <claimable>false</claimable>
      <destroySound>BuildingDestroyed_Metal_Big</destroySound>
      <paintable>true</paintable>
      <isInert>true</isInert>
      <forcedCostLeavings>
        <li MayRequire="Ludeon.RimWorld.Odyssey">ShuttleEngine</li>
      </forcedCostLeavings>
    </building>
    <inspectorTabs>
      <li>ITab_ContentsTransporter</li>
    </inspectorTabs>
    <researchPrerequisites>
      <li>Shuttles</li>
    </researchPrerequisites>
    <comps>
      <li Class="CompProperties_Shuttle">
        <shipDef>MCW_BucketShuttle_Ship</shipDef>
      </li>
      <li Class="CompProperties_Launchable">
        <fuelPerTile>2</fuelPerTile>
        <minFuelCost>35</minFuelCost>
        <skyfallerLeaving>MCW_BucketShuttle_Leaving</skyfallerLeaving>
        <worldObjectDef>MCW_BucketShuttle_World</worldObjectDef>
        <cooldownTicks>3750</cooldownTicks>
        <fixedLaunchDistanceMax>56</fixedLaunchDistanceMax>
        <cooldownEndedMessage>{0}已准备好再次起飞。</cooldownEndedMessage>
      </li>
      <li Class="CompProperties_Transporter">
        <massCapacity>500</massCapacity>
        <max1PerGroup>true</max1PerGroup>
        <canChangeAssignedThingsAfterStarting>true</canChangeAssignedThingsAfterStarting>
        <pawnLoadedSound>Shuttle_PawnLoaded</pawnLoadedSound>
        <pawnExitSound>Shuttle_PawnExit</pawnExitSound>
        <showMassInInspectString>true</showMassInInspectString>
      </li>
      <li Class="CompProperties_Refuelable">
        <fuelCapacity>1000</fuelCapacity>
        <targetFuelLevelConfigurable>true</targetFuelLevelConfigurable>
        <initialConfigurableTargetFuelLevel>1000</initialConfigurableTargetFuelLevel>
        <fuelFilter>
          <thingDefs>
            <li>Mincho_Mintchoco</li>
            <li>Mincho_BluePolarBear</li>
            <li>Mincho_PinkFallInLove</li>
          </thingDefs>
        </fuelFilter>
        <fuelLabel>冰淇淋储备</fuelLabel>
        <fuelGizmoLabel>冰淇淋</fuelGizmoLabel>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
        <autoRefuelPercent>1</autoRefuelPercent>
        <showFuelGizmo>true</showFuelGizmo>
        <drawOutOfFuelOverlay>false</drawOutOfFuelOverlay>
        <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
        <canEjectFuel>false</canEjectFuel>
        <fuelMultiplier>1</fuelMultiplier>
      </li>
      <li Class="CompProperties_AmbientSound">
        <sound>ShuttleIdle_Ambience</sound>
      </li>
    </comps>
    <placeWorkers>
      <li>PlaceWorker_NotUnderRoof</li>
    </placeWorkers>
    <uiOrder>2600</uiOrder>
  </ThingDef>
  <TransportShipDef>
    <defName>MCW_BucketShuttle_Ship</defName>
    <label>冰淇淋桶飞行器</label>
    <shipThing>MCW_BucketShuttle</shipThing>
    <arrivingSkyfaller>MCW_BucketShuttle_Incoming</arrivingSkyfaller>
    <leavingSkyfaller>MCW_BucketShuttle_Leaving</leavingSkyfaller>
    <worldObject>MCW_BucketShuttle_World</worldObject>
    <playerShuttle>true</playerShuttle>
  </TransportShipDef>
  <ThingDef ParentName="ShuttleSkyfallerBase">
    <defName>MCW_BucketShuttle_Incoming</defName>
    <label>冰淇淋桶（降落中）</label>
    <thingClass>MinchoCandyWars.Odyssey.BucketIncoming</thingClass>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <drawRotated>false</drawRotated>
      <texPath>Things/Building/BucketShuttle/Bucket</texPath>
      <shaderType>Cutout</shaderType>
      <drawSize>(4,4)</drawSize>
    </graphicData>
    <size>(4,4)</size>
    <skyfaller>
      <anticipationSound>Shuttle_Landing</anticipationSound>
      <anticipationSoundTicks>250</anticipationSoundTicks>
      <ticksToImpactRange>200~250</ticksToImpactRange>
      <minimalRoofDestruction>true</minimalRoofDestruction>
      <shadowSize>(4,4)</shadowSize>
      <rotationCurve>
        <points>
          <li>(0,0)</li>
          <li>(1,0)</li>
        </points>
      </rotationCurve>
      <zPositionCurve>
        <points>
          <li>(0,0)</li>
          <li>(1,0)</li>
        </points>
      </zPositionCurve>
      <speedCurve>
        <points>
          <li>(0.6,0.6)</li>
          <li>(0.95,0.1)</li>
        </points>
      </speedCurve>
    </skyfaller>
  </ThingDef>
  <ThingDef ParentName="ShuttleSkyfallerBase">
    <defName>MCW_BucketShuttle_Leaving</defName>
    <label>冰淇淋桶（起飞中）</label>
    <thingClass>MinchoCandyWars.Odyssey.BucketLeaving</thingClass>
    <rotatable>true</rotatable>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <drawRotated>false</drawRotated>
      <texPath>Things/Building/BucketShuttle/Bucket</texPath>
      <shaderType>Cutout</shaderType>
      <drawSize>(4,4)</drawSize>
    </graphicData>
    <size>(4,4)</size>
    <skyfaller>
      <reversed>true</reversed>
      <anticipationSound>Shuttle_Leaving</anticipationSound>
      <anticipationSoundTicks>-10</anticipationSoundTicks>
      <ticksToImpactRange>-40~-15</ticksToImpactRange>
      <moteSpawnTime>0.05</moteSpawnTime>
      <shadow>Things/Skyfaller/SkyfallerShadowRectangle</shadow>
      <shadowSize>(4,4)</shadowSize>
      <motesPerCell>1</motesPerCell>
      <rotationCurve>
        <points>
          <li>(0,0)</li>
          <li>(1,0)</li>
        </points>
      </rotationCurve>
      <zPositionCurve>
        <points>
          <li>(0,0)</li>
          <li>(1,0)</li>
        </points>
      </zPositionCurve>
      <speedCurve>
        <points>
          <li>(0,0.2)</li>
          <li>(0.4,0.7)</li>
        </points>
      </speedCurve>
    </skyfaller>
  </ThingDef>
  <WorldObjectDef ParentName="ShuttleWorldObjectBase">
    <defName>MCW_BucketShuttle_World</defName>
    <label>冰淇淋桶飞行器</label>
    <description>载着乘员和货物飞行的巨大冰淇淋桶。</description>
    <expandingIconTexture>Things/Building/BucketShuttle/Bucket</expandingIconTexture>
    <expandingIconDrawSize>1</expandingIconDrawSize>
  </WorldObjectDef>
</Defs>
